# Protege arquivos de configuracao da API.
# db_config.php contem as credenciais do banco; nao deve ser baixavel.
<Files "db_config.php">
    Require all denied
</Files>

# Bloqueia artefatos de editor/backups que podem vazar codigo-fonte.
<FilesMatch "\.(bak|old|orig|save|swp|log|sql|env|ini)$">
    Require all denied
</FilesMatch>

# Estes arquivos foram removidos do repositorio, mas o deploy nao apaga
# arquivos remotos (deleteRemote esta desligado), entao ainda existem no
# servidor. Sao negados aqui ate que sejam apagados via FTP.
# register.php permitia criar uma conta 'editor' sem autenticacao.
<FilesMatch "^(register|debug|debug2|test_db)\.php$">
    Require all denied
</FilesMatch>

# Impede listagem de diretorio da API.
Options -Indexes