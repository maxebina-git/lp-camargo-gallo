# Defesa em profundidade: o upload.php ja deriva a extensao do MIME real da
# imagem (jpg/png/webp/gif), entao um script nunca chega a ser gravado aqui.
# Ainda assim, bloqueia execucao de qualquer script nesta pasta.
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<FilesMatch "\.(php|phtml|phar|php[0-9]|pl|py|cgi|asp|aspx|sh)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
