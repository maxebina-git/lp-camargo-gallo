---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Container, Heading, Section } from 'ds-grupo-rkb';
import { insights } from '../data/insights';
import InsightCard from '../components/insights/InsightCard.astro';
---

<BaseLayout title="Insights & Conhecimento | Camargo Gallo Engenharia" description="Artigos técnicos sobre recuperação de fachadas, normas de segurança e manutenção predial.">

  <Section tone="warm" class="py-20">
    <Container size="lg">
      <div class="flex flex-col items-center text-center mb-16 gap-4">
        <div role="separator" aria-hidden="true" class="h-4 w-1/2 rounded-full bg-divider"></div>
        <Heading as="1" size="display" class="section-title">Insights & Conhecimento</Heading>
        <p class="text-deep/70 max-w-2xl font-body">
          Explore nossos artigos técnicos sobre patologias construtivas, normas de segurança e as melhores práticas em manutenção de fachadas.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {insights.map((post) => (
          <InsightCard 
            titulo={post.titulo} 
            resumo={post.resumo} 
            data={post.data} 
            categoria={post.categoria} 
            slug={post.slug} 
          />
        ))}
      </div>
    </Container>
  </Section>

</BaseLayout>
