---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Container, Heading, Section, Button } from 'ds-grupo-rkb';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import { siteBase, apiBase } from '../lib/paths';
---

<BaseLayout title="Obra | Camargo Gallo Engenharia" description="Detalhes da obra do portfólio da Camargo Gallo Engenharia.">

  <SiteHeader surface="warm" />

  <Section tone="warm" class="py-20">
    <Container size="lg">
      <div id="portfolio-status" class="py-20 text-center text-deep/60 font-body">Carregando…</div>

      <article id="portfolio-article" class="max-w-3xl mx-auto" hidden>
        <div class="mb-12 text-center">
          <Heading as="1" size="display" class="mb-4" id="portfolio-titulo"></Heading>
          <div class="flex justify-center gap-4 text-sm text-deep/60 font-body">
            <span id="portfolio-meta"></span>
          </div>
        </div>

        <div id="portfolio-video-wrap" class="mb-12" hidden>
          <div class="video-embed">
            <iframe
              id="portfolio-video"
              src=""
              title="Vídeo da obra"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            ></iframe>
          </div>
        </div>

         <div class="prose prose-lg max-w-none text-ink leading-relaxed font-body mb-12">
           <div id="portfolio-descricao" class="text-lg"></div>
        </div>

        <div class="mb-12" id="portfolio-imagem-wrap">
          <figure class="portfolio-figure">
            <img id="portfolio-imagem" src="" alt="" class="w-full aspect-[3/2] object-cover rounded-2xl shadow-lg cursor-zoom-in" />
            <figcaption id="portfolio-legenda" class="portfolio-legenda" data-legenda-bloco hidden>
              <button type="button" id="portfolio-legenda-btn" class="portfolio-legenda-btn">
                <span id="portfolio-legenda-texto" class="portfolio-legenda-texto"></span>
                <span class="portfolio-legenda-acao" aria-hidden="true">ver no slideshow</span>
                <span class="sr-only">abrir no slideshow</span>
              </button>
            </figcaption>
          </figure>
          <div id="portfolio-thumbs-wrap" class="thumbs-wrap" hidden>
            <button id="thumbs-prev" type="button" class="thumbs-nav prev" aria-label="Ver miniaturas anteriores">&lsaquo;</button>
            <div id="portfolio-thumbs" class="gallery-thumbs">
              <div id="portfolio-thumbs-track" class="gallery-thumbs-track"></div>
            </div>
            <button id="thumbs-next" type="button" class="thumbs-nav next" aria-label="Ver próximas miniaturas">&rsaquo;</button>
          </div>
        </div>

        <div class="mt-16 pt-8 border-t border-[var(--color-divider)] flex justify-between items-center">
          <Button as="a" href={siteBase + '/portfolio'} variant="secondary" class="font-body">← Voltar ao Portfólio</Button>
        </div>
      </article>
    </Container>
  </Section>

  <div id="portfolio-lightbox" class="lightbox" aria-hidden="true">
    <button id="lb-close" type="button" class="lb-btn lb-close" aria-label="Fechar">&times;</button>
    <button id="lb-prev" type="button" class="lb-btn lb-prev" aria-label="Imagem anterior">&lsaquo;</button>
    <figure class="lb-stage">
      <img id="lb-img" src="" alt="" />
      <figcaption class="lb-legendas">
        <p id="lb-count" class="lb-count"></p>
        <p id="lb-legenda" class="lb-legenda" hidden></p>
      </figcaption>
    </figure>
    <button id="lb-next" type="button" class="lb-btn lb-next" aria-label="Próxima imagem">&rsaquo;</button>
  </div>

  <script is:inline define:vars={{ apiBase, siteBase }}>
    (function () {
      var parts = window.location.pathname.replace(/\/+$/, '').split('/');
      var slug = decodeURIComponent(parts[parts.length - 1] || '');

      /* Caminhos de imagem vindos do banco sao relativos a raiz do site
         (/assets/uploads/...). No staging precisam do prefixo do deploy. */
      function asset(path) {
        if (!path) return '';
        var value = String(path);
        if (/^(https?:)?\/\//i.test(value)) return value;
        if (value.charAt(0) !== '/') return value;
        return siteBase + value;
      }

      var statusEl = document.getElementById('portfolio-status');
      var article = document.getElementById('portfolio-article');

      var galeria = [];
      var legendas = [];
      var heroIndex = 0;
      var obraTitulo = '';
      var lightbox = document.getElementById('portfolio-lightbox');
      var lbImg = document.getElementById('lb-img');
      var lbCount = document.getElementById('lb-count');
      var lbLegenda = document.getElementById('lb-legenda');
      var lbIndex = 0;
      var lbLastFocus = null;
      var lbOpen = false;

      var thumbsEl = document.getElementById('portfolio-thumbs');
      var thumbsWrap = document.getElementById('portfolio-thumbs-wrap');
      var thumbsPrev = document.getElementById('thumbs-prev');
      var thumbsNext = document.getElementById('thumbs-next');
      var THUMB_STEP = (200 + 12) * 2;

      function fail(message) {
        statusEl.textContent = message;
        statusEl.hidden = false;
        article.hidden = true;
      }

      function meta(item) {
        var p = [];
        if (item.cidade) p.push(item.cidade);
        if (item.ano) p.push(item.ano);
        return p.join(' · ');
      }

      /* Extrai o ID de qualquer formato de link do YouTube:
         youtu.be/ID?si=..., watch?v=ID, /embed/ID, /shorts/ID, /live/ID.
         Retorna '' se nao for um link reconhecivel — ai o bloco simplesmente
         nao aparece. */
      function youtubeId(url) {
        if (!url || typeof url !== 'string') return '';
        var m = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?(?:[^#]*&)?v=|embed\/|shorts\/|live\/))([A-Za-z0-9_-]{11})/);
        return m ? m[1] : '';
      }

      /* Reinicia a animacao de entrada de um texto. Reescrever a mesma
         classe nao reinicia a animacao, entao o reflow forcado
         (offsetWidth) e o que faz ela tocar de novo. */
      function animarEntrada(el) {
        if (!el) return;
        el.classList.remove('is-entrando');
        void el.offsetWidth;
        el.classList.add('is-entrando');
      }

      /* Legenda da imagem: escreve o texto e esconde o bloco quando o item
         nao tem legenda. O bloco e o <figcaption> da pagina do case (que
         carrega o botao do slideshow) e o proprio <p> no overlay — por isso
         o closest: no overlay nao ha [data-legenda-bloco] e o elemento
         esconde a si mesmo, como antes.
         Quando o texto muda, a entrada e animada — e o que da sensacao de
         troca no slideshow (o texto trocava seco, em cima do fade da
         imagem). */
      function aplicarLegenda(el, index) {
        if (!el) return;
        var texto = String(legendas[index] || '').trim();
        var mudou = el.textContent !== texto;
        el.textContent = texto;
        var bloco = el.closest('[data-legenda-bloco]') || el;
        bloco.hidden = !texto;
        if (texto && mudou) animarEntrada(el);
      }

      /* Troca a imagem principal e o thumb ativo. E o unico ponto que
         define heroIndex: clique no thumb e navegacao do lightbox passam
         por aqui, entao principal, faixa e lightbox nunca divergem. */
      function showHero(index) {
        if (!galeria.length) return;
        heroIndex = (index + galeria.length) % galeria.length;
        var hero = document.getElementById('portfolio-imagem');
        hero.src = galeria[heroIndex];
        hero.alt = obraTitulo || ('Imagem ' + (heroIndex + 1) + ' de ' + galeria.length);
        aplicarLegenda(document.getElementById('portfolio-legenda-texto'), heroIndex);
        var thumbs = document.getElementById('portfolio-thumbs-track').querySelectorAll('.gallery-thumb');
        for (var i = 0; i < thumbs.length; i++) {
          var active = i === heroIndex;
          thumbs[i].classList.toggle('is-active', active);
          if (active) thumbs[i].scrollIntoView({ block: 'nearest', inline: 'nearest' });
        }
      }

      function showLightbox(index) {
        lbIndex = (index + galeria.length) % galeria.length;
        lbImg.src = galeria[lbIndex];
        lbImg.alt = 'Imagem ' + (lbIndex + 1) + ' de ' + galeria.length;
        lbCount.textContent = (lbIndex + 1) + ' / ' + galeria.length;
        animarEntrada(lbCount);
        aplicarLegenda(lbLegenda, lbIndex);
        showHero(lbIndex);
      }

      function openLightbox(index) {
        if (!galeria.length) return;
        lbLastFocus = document.activeElement;
        lbOpen = true;
        lightbox.classList.add('is-open');
        lightbox.setAttribute('aria-hidden', 'false');
        document.documentElement.style.overflow = 'hidden';
        showLightbox(index);
        document.getElementById('lb-close').focus();
      }

      function closeLightbox() {
        lbOpen = false;
        lightbox.classList.remove('is-open');
        lightbox.setAttribute('aria-hidden', 'true');
        document.documentElement.style.overflow = '';
        if (lbLastFocus && lbLastFocus.focus) lbLastFocus.focus();
      }

      function updateThumbNav() {
        if (thumbsWrap.hidden) return;
        var overflow = thumbsEl.scrollWidth > thumbsEl.clientWidth + 1;
        thumbsPrev.classList.toggle('is-visible', overflow && thumbsEl.scrollLeft > 1);
        thumbsNext.classList.toggle('is-visible', overflow && thumbsEl.scrollLeft < thumbsEl.scrollWidth - thumbsEl.clientWidth - 1);
      }

      function scrollThumbs(direction) {
        thumbsEl.scrollBy({ left: direction * THUMB_STEP, behavior: 'smooth' });
      }

      function renderThumbs(titulo) {
        if (galeria.length < 2) return;
        var track = document.getElementById('portfolio-thumbs-track');
        galeria.forEach(function (src, i) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'gallery-thumb';
          btn.setAttribute('aria-label', 'Ver imagem ' + (i + 1) + ' de ' + galeria.length + (titulo ? ' de ' + titulo : ''));

          var thumb = document.createElement('img');
          thumb.src = src;
          thumb.alt = '';
          thumb.loading = 'lazy';
          thumb.addEventListener('error', function () {
            btn.hidden = true;
          });

          btn.appendChild(thumb);
          btn.addEventListener('click', function () {
            showHero(i);
          });
          track.appendChild(btn);
        });
        thumbsWrap.hidden = false;
      }

      document.getElementById('lb-close').addEventListener('click', closeLightbox);
      document.getElementById('lb-prev').addEventListener('click', function () {
        showLightbox(lbIndex - 1);
      });
      document.getElementById('lb-next').addEventListener('click', function () {
        showLightbox(lbIndex + 1);
      });
      lightbox.addEventListener('click', function (event) {
        if (event.target === lightbox) closeLightbox();
      });
      document.addEventListener('keydown', function (event) {
        if (!lbOpen) return;
        if (event.key === 'Escape') closeLightbox();
        else if (event.key === 'ArrowRight') showLightbox(lbIndex + 1);
        else if (event.key === 'ArrowLeft') showLightbox(lbIndex - 1);
      });

      thumbsEl.addEventListener('scroll', updateThumbNav, { passive: true });
      window.addEventListener('resize', updateThumbNav);
      thumbsPrev.addEventListener('click', function () {
        scrollThumbs(-1);
      });
      thumbsNext.addEventListener('click', function () {
        scrollThumbs(1);
      });

      /* A imagem principal e uma das portas de entrada do lightbox: cliques
         nos thumbs trocam a imagem (showHero), nao abrem o overlay. */
      document.getElementById('portfolio-imagem').addEventListener('click', function () {
        openLightbox(heroIndex);
      });

      /* A legenda da pagina do case e a outra porta: a legenda e a da imagem
         que esta na principal (as duas andam juntas em showHero), entao
         clicar nela abre o slideshow na imagem correspondente — e o jeito de
         ler a legenda inteira, que aqui fica truncada em uma linha. */
      document.getElementById('portfolio-legenda-btn').addEventListener('click', function () {
        openLightbox(heroIndex);
      });

      if (!slug) {
        fail('Obra não encontrada.');
        return;
      }

      fetch(apiBase + '/public/portfolio_item.php?slug=' + encodeURIComponent(slug))
        .then(function (response) {
          if (response.status === 404) {
            // Slug antigo: a API diz para onde a obra foi. Troca a URL
            // em vez de mostrar "nao encontrada".
            return response.json().then(function (data) {
              if (data && data.redirect) {
                window.location.replace(siteBase + '/portfolio/' + data.redirect + '/');
                return null;
              }
              fail('Obra não encontrada.');
              return null;
            });
          }
          if (!response.ok) throw new Error('HTTP ' + response.status);
          return response.json();
        })
        .then(function (item) {
          if (!item) return;

          document.title = item.titulo + ' | Camargo Gallo Engenharia';
          /* A pagina e servida em /portfolio/<slug>/ (via rewrite no
             .htaccess), mas o build so conhece /portfolio-view/. O canonical
             e o og:url precisam apontar para a URL real. */
          var urlReal = siteBase + '/portfolio/' + slug + '/';
          var canonicalEl = document.querySelector('link[rel="canonical"]');
          if (canonicalEl) canonicalEl.setAttribute('href', urlReal);
          var ogUrlEl = document.querySelector('meta[property="og:url"]');
          if (ogUrlEl) ogUrlEl.setAttribute('content', urlReal);
          obraTitulo = item.titulo;
          document.getElementById('portfolio-titulo').textContent = item.titulo;
          document.getElementById('portfolio-meta').textContent = meta(item);
           document.getElementById('portfolio-descricao').innerHTML = item.descricao || '';

          var videoId = youtubeId(item.video_youtube);
          if (videoId) {
            document.getElementById('portfolio-video').src =
              'https://www.youtube-nocookie.com/embed/' + videoId + '?rel=0';
            document.getElementById('portfolio-video-wrap').hidden = false;
          }

          var wrap = document.getElementById('portfolio-imagem-wrap');
          var img = document.getElementById('portfolio-imagem');
          galeria = (Array.isArray(item.imagens) && item.imagens.length)
            ? item.imagens.map(asset)
            : (item.imagem ? [asset(item.imagem)] : []);
          legendas = Array.isArray(item.legendas) ? item.legendas.slice() : [];

          if (galeria.length) {
            img.addEventListener('error', function () {
              wrap.hidden = true;
            });
            renderThumbs(item.titulo);
            showHero(0);
          } else {
            wrap.hidden = true;
          }

          statusEl.hidden = true;
          article.hidden = false;
          requestAnimationFrame(updateThumbNav);
        })
        .catch(function (error) {
          console.error(error);
          fail('Não foi possível carregar a obra.');
        });
    })();
  </script>

  <SiteFooter surface="warm" />

  <style>
    #portfolio-descricao {
      overflow-x: auto;
    }

    :global(#portfolio-descricao p) {
      margin: 0 0 1rem;
    }

    :global(#portfolio-descricao ul) {
      list-style: disc;
      margin: 1rem 0;
      padding-left: 1.5rem;
    }

    :global(#portfolio-descricao li) {
      margin: 0.35rem 0;
    }

    :global(#portfolio-descricao blockquote) {
      margin: 1.25rem 0;
      border-left: 4px solid var(--color-divider);
      padding-left: 1rem;
      color: var(--color-deep);
      opacity: 0.8;
      font-style: italic;
    }

    :global(#portfolio-descricao strong),
    :global(#portfolio-descricao b) {
      font-weight: 700;
    }

    :global(#portfolio-descricao u) {
      text-decoration-line: underline;
      text-underline-offset: 0.15em;
    }

    :global(#portfolio-descricao a) {
      color: var(--color-deep);
      text-decoration-line: underline;
      text-underline-offset: 0.15em;
    }

    :global(#portfolio-descricao a:hover) {
      opacity: 0.75;
    }

    /* Faixa de miniaturas: scroll container horizontal, mesmo contrato do
       .servicos-slider da home. overflow-y: hidden e obrigatorio: com
       overflow-x:auto o eixo Y seria auto, e qualquer overflow vertical
       (borda focada do thumb, imagem de um px a mais) faria a faixa tomar o
       gesto de scroll vertical e nao encadear para a pagina. Escondido, o
       gesto vertical sempre sobe; o horizontal resolve no snap-x da faixa.
       touch-action: pan-x pan-y declara os dois eixos: o navegador faz o pan
       horizontal na faixa, o vertical sobe pelo scroll chain. Esconde a
       scrollbar para a faixa ficar limpa (arrasto com mouse continua).
       O track interno e width:max-content + margin-inline:auto: quando os
       thumbs cabem na largura da imagem principal ele os centraliza; quando
       nao cabem as margens viram 0 e a faixa rola normal — o
       justify-content:center direto no scroll container deixaria os
       primeiros thumbs inalcancaveis (overflow negativo no inicio).
       :global nos rules dos thumbs porque os <button> sao criados em runtime
       via JS e nao recebem o data-astro-cid-* do escopo do Astro — sem
       global, cada thumb ficava no tamanho natural da imagem. */
    /* Vídeo do YouTube: box 16:9 com o iframe absolutamente encaixado —
       mesma linguagem visual da imagem principal (rounded + shadow). */
    .video-embed {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      border-radius: 1rem;
      overflow: hidden;
      box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
      background: #000;
    }

    .video-embed iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }

    .thumbs-wrap {
      position: relative;
      margin-top: 1rem;
    }

    .thumbs-wrap[hidden] {
      display: none;
    }

    .gallery-thumbs {
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      touch-action: pan-x pan-y;
      padding-bottom: 2px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .gallery-thumbs::-webkit-scrollbar {
      display: none;
    }

    .gallery-thumbs-track {
      display: flex;
      gap: 0.75rem;
      width: max-content;
      margin-inline: auto;
    }

    /* Caixa fixa 200x125: a imagem "encaixa" por object-fit:cover, entao
       fotos de proporcoes diferentes viram a mesma miniatura. Dimensao em px
       (nao rem) porque o pedido e de tamanho definido. */
    :global(.gallery-thumb) {
      position: relative;
      flex-shrink: 0;
      width: 200px;
      height: 125px;
      border-radius: 0.5rem;
      overflow: hidden;
      scroll-snap-align: start;
      border: 2px solid transparent;
      cursor: pointer;
      opacity: 0.7;
      transition: opacity 0.15s ease, border-color 0.15s ease;
    }

    :global(.gallery-thumb:hover),
    :global(.gallery-thumb:focus-visible) {
      opacity: 1;
      border-color: var(--color-deep, #2b2118);
    }

    /* Thumb da imagem que esta na principal — mesmo tratamento do hover
       para continuar valendo depois que o mouse sai. */
    :global(.gallery-thumb.is-active) {
      opacity: 1;
      border-color: var(--color-deep, #2b2118);
    }

    :global(.gallery-thumb img) {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      pointer-events: none;
    }

    /* Setas da faixa: so aparecem quando os thumbs nao cabem (is-visible e
       setada no JS junto com a checagem de overflow), e cada uma some na
       propria ponta — sem thumb alem da borda, nao ha o que rolar naquele
       lado. Ficam sobre a faixa para nao ocupar altura extra. */
    .thumbs-nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 2;
      width: 2.25rem;
      height: 2.25rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 9999px;
      background: rgba(255, 255, 255, 0.92);
      color: var(--color-deep, #2b2118);
      font-size: 1.4rem;
      line-height: 1;
      cursor: pointer;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.15s ease, background 0.15s ease;
    }

    .thumbs-nav.is-visible {
      opacity: 1;
      pointer-events: auto;
    }

    .thumbs-nav:hover,
    .thumbs-nav:focus-visible {
      background: #fff;
      outline: none;
    }

    .thumbs-nav:active {
      transform: translateY(-50%) scale(0.94);
    }

    .thumbs-nav.prev {
      left: 0.25rem;
    }

    .thumbs-nav.next {
      right: 0.25rem;
    }

    /* Lightbox: fixed fora do Section de proposito — qualquer reveal com
       transform dentro da section viraria containing block do fixed.
       Abre/feche com fade de opacity 0% -> 100% (classe .is-open no JS, o
       atributo hidden/display:none nao transiciona). visibility acompanha a
       opacity com delay so no fechamento: enquanto o fade dura, o overlay
       continua pintando; depois some e os botoes saem da tab-order (safer
       que so opacity — conteudo invisivel continuaria focavel/clicavel).
       Overlay translucido (0.8) para a pagina aparecer esmaecida atras. */
    .lightbox {
      position: fixed;
      inset: 0;
      z-index: 2000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      background: rgba(0, 0, 0, 0.8);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s ease, visibility 0s linear 0.3s;
    }

    .lightbox.is-open {
      opacity: 1;
      visibility: visible;
      transition: opacity 0.3s ease;
    }

    .lb-stage {
      margin: 0;
      max-width: min(100%, 1100px);
      /* Flex column: a imagem cede espaco para a coluna de texto quando a
         viewport e baixa. Antes a imagem tinha 82vh fixos e o contador + a
         legenda estouravam a tela — a legenda saia pela base do overlay e
         nao havia rolagem para alcancar. max-height: 100% trava a coluna na
         altura util do overlay (viewport menos o padding). */
      display: flex;
      flex-direction: column;
      align-items: center;
      max-height: 100%;
      opacity: 0;
      transform: scale(0.96);
      transition: opacity 0.3s ease, transform 0.3s ease;
    }

    .lightbox.is-open .lb-stage {
      opacity: 1;
      transform: scale(1);
    }

    .lb-stage img {
      display: block;
      margin: 0 auto;
      max-width: 100%;
      /* flex-shrink + min-height: a imagem encolhe para a legenda caber,
         mas nunca some (min-height). object-fit: contain mantem a
         proporcao se a caixa encolher antes da largura. */
      flex: 0 1 auto;
      min-height: 12rem;
      max-height: 82vh;
      width: auto;
      height: auto;
      object-fit: contain;
      border-radius: 0.5rem;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    /* Legenda da imagem: a mesma tipografia nas duas visoes (pagina do
       case e overlay). O que muda entre elas e so a cor, porque o overlay
       e escuro — fonte, corpo e alinhamento sao iguais, para a legenda nao
       mudar de cara quando o usuario abre o slideshow. */
    .portfolio-legenda,
    .lb-legenda {
      font-family: var(--font-body);
      font-size: 0.875rem;
      line-height: 1.5;
      text-align: left;
    }

    /* Pagina do case: a legenda e o gatilho do slideshow. Cabe em UMA
       linha (o texto longo e cortado com reticencias) e a dica "ver no
       slideshow" convida a abrir a imagem para ler a legenda inteira. */
    .portfolio-legenda-btn {
      display: flex;
      align-items: baseline;
      gap: 0.375rem;
      width: 100%;
      text-align: left;
      cursor: pointer;
    }

    /* Uma linha so, com reticencias: min-width: 0 + nowrap + ellipsis.
       min-width: 0 e o que deixa o item encolher dentro do flex (sem ele
       o texto empurra a dica para fora da linha). A utilitaria line-clamp-1
       do Tailwind nao serve aqui: ela exige display: -webkit-box, que
       blockifica os filhos e briga com o item flex — o resultado visual
       seria o mesmo, mas com o comportamento incerto. */
    .portfolio-legenda-texto {
      flex: 0 1 auto;
      min-width: 0;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    .portfolio-legenda-acao {
      flex: 0 0 auto;
      text-decoration: underline;
      text-underline-offset: 0.15em;
      white-space: nowrap;
    }

    .portfolio-legenda-btn:hover .portfolio-legenda-texto,
    .portfolio-legenda-btn:focus-visible .portfolio-legenda-texto {
      text-decoration: underline;
      text-underline-offset: 0.15em;
    }

    .portfolio-legenda-btn:focus-visible {
      outline: 2px solid var(--color-focus-ring);
      outline-offset: 2px;
    }

    /* Pagina do case: a legenda comeca na borda esquerda da imagem (o
       <figcaption> e filho do <figure>, entao herda a mesma largura). */
    .portfolio-legenda {
      margin-top: 0.5rem;
      color: var(--color-deep);
    }

    /* O fallback solido acima + o color-mix dentro do @supports: e o mesmo
       desenho que o design system usa nas utilidades com opacidade. */
    @supports (color: color-mix(in oklab, var(--color-deep) 75%, transparent)) {
      .portfolio-legenda {
        color: color-mix(in oklab, var(--color-deep) 75%, transparent);
      }
    }

    /* Overlay: coluna de texto (contador + legenda) encostada na borda
       esquerda da foto, igual a pagina do case. align-self: stretch com
       max-width = a coluna ocupa a largura da imagem e para nela. */
    .lb-legendas {
      align-self: stretch;
      max-width: 68ch;
      text-align: left;
      flex: 0 1 auto;
      min-height: 0;
      /* overflow-y: rede de seguranca para legenda longa demais — a coluna
         rola por dentro em vez de sair da tela. overflow-x: hidden evita a
         barra horizontal que apareceria com o overflow implicito. */
      overflow: hidden auto;
    }

    .lb-count {
      margin-top: 0.75rem;
      font-family: var(--font-body);
      font-size: 0.875rem;
      color: rgba(255, 255, 255, 0.75);
    }

    .lb-legenda {
      margin-top: 0.25rem;
      color: rgba(255, 255, 255, 0.92);
    }

    /* Entrada do texto: quando a legenda (ou o contador) troca, o texto
       aparece com um fade curto. O JS reescreve a classe a cada troca, e
       reescrever a mesma classe nao reinicia animacao — por isso o
       reflow forcado no lado do JS.
       Fade puro, sem deslocamento: um translateY de poucos pixels transbordaria
       a caixa da coluna no overlay e acenderia a barra de rolagem por um
       instante a cada troca. */
    @keyframes legenda-entrada {
      from {
        opacity: 0;
      }

      to {
        opacity: 1;
      }
    }

    .is-entrando {
      animation: legenda-entrada 0.25s ease both;
    }

    .lb-btn {
      position: absolute;
      width: 2.75rem;
      height: 2.75rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 9999px;
      background: rgba(255, 255, 255, 0.12);
      color: #fff;
      font-size: 1.75rem;
      line-height: 1;
      cursor: pointer;
      transition: background 0.15s ease;
    }

    .lb-btn:hover,
    .lb-btn:focus-visible {
      background: rgba(255, 255, 255, 0.28);
      outline: none;
    }

    .lb-close {
      top: 1rem;
      right: 1rem;
      font-size: 1.5rem;
    }

    .lb-prev {
      left: 1rem;
      top: 50%;
      transform: translateY(-50%);
    }

    .lb-next {
      right: 1rem;
      top: 50%;
      transform: translateY(-50%);
    }

    @media (width < 40rem) {
      .lb-prev {
        left: 0.5rem;
      }

      .lb-next {
        right: 0.5rem;
      }
    }
  </style>
</BaseLayout>
