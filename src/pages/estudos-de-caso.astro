---
import BaseLayout from '../layouts/BaseLayout.astro'
import { Container, Heading, Section } from 'ds-grupo-rkb'
import SiteHeader from '../components/layout/SiteHeader.astro'
import SiteFooter from '../components/layout/SiteFooter.astro'
---

<BaseLayout
  title="Estudos de Caso | Camargo Gallo Engenharia"
  description="Estudos de caso de revitalização, retrofit, pintura e impermeabilização de fachadas pela Camargo Gallo."
>

  <SiteHeader />

  <Section tone="surface" class="py-20">
    <Container size="lg">
      <div class="flex flex-col items-center text-center gap-4">
        <div role="separator" aria-hidden="true" class="h-4 w-1/2 rounded-full bg-divider"></div>
        <Heading as="1" size="display" class="section-title">Estudos de Caso</Heading>
      </div>
    </Container>
  </Section>

  <SiteFooter />

</BaseLayout>
