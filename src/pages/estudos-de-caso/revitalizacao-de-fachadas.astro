---
import { existsSync } from 'node:fs'
import { fileURLToPath } from 'node:url'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { Container, Heading, Section } from 'ds-grupo-rkb'
import SiteHeader from '../../components/layout/SiteHeader.astro'
import SiteFooter from '../../components/layout/SiteFooter.astro'

/* O texto e as listas sao os do caso que o cliente forneceu — sao dados, e
   ficam no frontmatter (como as fotos e os compromissos de segurca.astro) e
   nao no template. Se as outras tres paginas de estudo de caso ganharem
   conteudo, a extracao para src/data/estudos-de-caso.ts e mecanica: as tres
   paginas nao passam a importar nada daqui.

   O par antes/depois aponta para os caminhos finais das fotos. A checagem em
   existsSync e o que permite deixar o placeholder no lugar sem virar imagem
   quebrada: enquanto o .webp nao estiver em public/, a figura sai como caixa
   cinza com o aviso; depois que o arquivo for salvo e o site rebuildar, o
   <img> entra sozinho e ninguem mexe em codigo. Por isso o caminho e montado
   a partir da pasta do arquivo (public fica em ../../../ a partir daqui) e nao
   um literal solto. */
const pastaImagens = '../../../public/assets/estudos-de-caso/revitalizacao-de-fachadas'

const fotos = [
  {
    rotulo: 'Antes',
    arquivo: 'antes.webp',
    alt: 'Fachada do edifício antes da revitalização, com revestimento cerâmico deteriorado',
  },
  {
    rotulo: 'Depois',
    arquivo: 'depois.webp',
    alt: 'Fachada do edifício após a revitalização, com revestimento recuperado',
  },
].map((foto) => {
  const src = `/assets/estudos-de-caso/revitalizacao-de-fachadas/${foto.arquivo}`
  const caminho = new URL(`${pastaImagens}/${foto.arquivo}`, import.meta.url)
  return { ...foto, src, existe: existsSync(fileURLToPath(caminho)) }
})

const servicosRealizados = [
  'Ensaio de percussão',
  'Remoção das cerâmicas e do emboço solto',
  'Remoção do substrato com corrosão',
  'Hidrojateamento',
  'Tratamento das armaduras',
  'Proteção das armaduras e recomposição do concreto',
  'Recomposição do chapisco e do emboço',
  'Tratamento de fissuras e trincas no emboço',
  'Reinstalação das cerâmicas e tratamento dos rejuntes',
  'Substituição de pingadeiras em mármore das varandas',
  'Tratamento das juntas de movimentação',
  'Cafetização dos caixilhos das janelas',
  'Aplicação de impermeabilizante acrílico',
  'Pintura das fachadas e guarda-corpos das sacadas',
  'Tratamento dos muros internos e guarita',
  'Tratamento e pintura da quadra',
]

/* Depoimento em dois paragrafos: o texto do cliente ja vem em blocos, e um <p>
   so com tudo junto deixaria a citacao corrida demais na caixa.

   Cada paragrafo e uma lista de trechos, e nao uma string com HTML: o
   frontmatter de um .astro e TypeScript puro, sem JSX — um fragmento <> ali
   quebra o build (ja aconteceu nesta pagina). Marcar o grifo como dado tambem
   evita set:html, que desligaria a checagem de escape do Astro justamente no
   texto que vem do cliente. A quebra de paragrafo e a quebra de trecho sao
   coisas diferentes, e por isso duas estruturas: paragrafos > partes. */
type Trecho = { texto: string; destaque?: boolean }

const depoimento: { paragrafos: Trecho[][]; autor: string; papel: string } = {
  paragrafos: [
    [
      { texto: 'A ' },
      { texto: 'Camargo Gallo', destaque: true },
      {
        texto:
          ' participou da cotação juntamente com outras duas engenharias apresentando ótimo preço considerado perante a concorrência. Efetuamos visitas nas obras da empresa, conversamos com os síndicos, vimos essas obras em andamento, muito bem feitas, muito bem trabalhadas e isso fez com que decidíssemos e escolhéssemos a ',
      },
      { texto: 'Camargo Gallo', destaque: true },
      { texto: '.' },
    ],
    [
      { texto: 'A experiência de trabalharmos com a ' },
      { texto: 'Camargo Gallo', destaque: true },
      {
        texto:
          ' está sendo muito satisfatória, muito gratificante, um trabalho tranquilo, um trabalho comprometido.',
      },
    ],
  ],
  autor: 'Walter Mesquita',
  papel: 'Síndico',
}
---

<BaseLayout
  title="Revitalização de fachadas e áreas comuns | Camargo Gallo Engenharia"
  description="Revitalização de fachadas e áreas comuns de condomínios e edifícios pela Camargo Gallo Engenharia."
>

  <SiteHeader />

  <Section tone="surface" class="py-20">
    <Container size="lg">
      <div class="flex flex-col items-center text-center gap-4">
        <div role="separator" aria-hidden="true" class="h-4 w-1/2 rounded-full bg-divider"></div>
        <Heading as="1" size="display" class="section-title">Revitalização de fachadas e áreas comuns</Heading>
      </div>
    </Container>
  </Section>

  <!-- Fotos antes/depois. mb-16 e nao py-20 como o bloco do titulo: aqui a
       section seguinte ja e colorida (a faixa navy entra colada), entao o
       respiro de 64px fica entre a grade e o fim da section, e nao duas vezes.
       O <figcaption> absoluto e o que traz o rotulo para dentro da foto sem
       ocupar espaco no fluxo. A pílula de bg-deep substitui o branco solto do
       desenho original: a parte de baixo da foto e escura e nao ha garantia de
       contraste do branco puro. -->
  <Section tone="surface" size="none" class="pb-16">
    <Container size="lg">
      <div class="grid gap-6 md:grid-cols-2">
        {fotos.map((foto) => (
          <figure class="relative aspect-[4/3] overflow-hidden rounded-lg bg-surface-alt">
            {foto.existe ? (
              <img
                src={foto.src}
                alt={foto.alt}
                width="800"
                height="600"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
              />
            ) : (
              /* Placeholder enquanto o arquivo nao existe: a caixa cinza e o
                 proprio <figure>, entao nao ha <img> com src quebrada. O aviso
                 some junto com a imagem quando o arquivo chega. */
              <p class="flex h-full items-center justify-center p-6 text-center text-sm text-text-secondary">
                Imagem pendente — salve como <strong class="font-semibold text-ink">{foto.src}</strong>
              </p>
            )}
            <figcaption class="absolute bottom-4 left-4 rounded-full bg-deep px-3 py-1 text-sm font-medium text-on-deep">
              {foto.rotulo}
            </figcaption>
          </figure>
        ))}
      </div>
    </Container>
  </Section>

  <!-- Faixa navy + lista em uma section so, com a faixa FORA do Container para
       sangrar na largura da tela. Sao duas sections se a faixa fosse um
       <Section tone="deep"> proprio, e ai a lista perderia o Container
       compartilhado: o h2 e os bullets precisam da mesma linha de base, e o
       padding py-* das duas sections viraria uma faixa cinza sobrando entre
       elas. py-0 no Section tira o padding de cima (py-16) para a faixa encostar
       no bloco das fotos.
       O h2 e o unico heading depois do h1: a pagina nao tinha nenhum, e a
       lista de servicos e uma secao nomeada, nao conteudo solto. uppercase e
       tracking-widest recriam a caixa alta espacada do desenho; uppercase vem
       tambem do DS em unlayered, com o mesmo valor. -->
  <Section tone="surface-alt" class="pt-0">
    <div class="bg-deep py-8">
      <Container size="lg">
        <Heading as="2" size="xl" class="text-center uppercase tracking-widest text-on-deep">
          Serviços realizados
        </Heading>
      </Container>
    </div>

    <Container size="lg" class="py-16">
      <!-- columns-2 em vez de duas <ul>: com 16 itens e dois Automaticamente
           fica com as colunas balanceadas sem eu escolher a quebra, e a lista
           continua sendo uma so no leitor de tela. columns-2 nao existe no DS,
           entao nao ha briga de camada. O ponto do item sai do ::before do
           <style> abaixo em vez de list-disc: marcador externo Combined com
           break-inside: avoid em coluna multipla faz o balanceamento engolir
           itens, e o ::before ainda deixa o <li> como bloco puro, que e o que o
           multicol precisa para quebrar entre itens e nao dentro deles. O
           mesmo ponto de 4px com bg-accent-500 ja e o marcador das listas de
           segurca (SafetyFeatureSection.astro). -->
      <ul class="columns-1 gap-x-8 md:columns-2">
        {servicosRealizados.map((servico) => (
          <li class="estudo-servico">{servico}</li>
        ))}
      </ul>
    </Container>
  </Section>

  <!-- Depoimento. Sem h2 de proposito: e uma citacao, nao uma secao — a marcação
       certa e <figure>/<blockquote>/<cite>, e um heading aqui seria um titulo
       que nao existe no desenho. O <strong class="destaque"> e o nome da empresa
       em grifo no texto do cliente. -->
  <Section tone="surface">
    <Container size="lg">
      <figure class="estudo-depoimento">
        <!-- As duas aspas do desenho sao elementos de verdade e nao ::before/
             ::after com content: '\201C'. O minificador de CSS do Vite
             converteu o escape unicode para aspas literais e o content saiu
             como """ — declaracao invalida, e a regra inteira morria junto.
             Elemento real nao passa por content, e o aria-hidden fica explicito
             em vez de subentendido no pseudo-elemento. -->
        <span aria-hidden="true" class="estudo-aspas estudo-aspas--abre">“</span>

        <blockquote class="text-justify italic leading-relaxed text-ink">
          {depoimento.paragrafos.map((paragrafo) => (
            <p class="mb-4 last:mb-0">
              {paragrafo.map((trecho) =>
                trecho.destaque ? (
                  <strong class="destaque">{trecho.texto}</strong>
                ) : (
                  trecho.texto
                )
              )}
            </p>
          ))}
        </blockquote>

        <!-- O <cite> carrega a atribuicao, que e o que ele significa na citacao: o
             "Walter Mesquita - Síndico" do desenho. Ele ja vem em italico do UA
             e o class mantem; o figcaption nao precisa declarar. A regra
             .destaque acima e so para o grifo da empresa dentro do texto. -->
        <figcaption class="mt-6 text-right text-sm">
          <cite class="font-semibold">— {depoimento.autor} - {depoimento.papel}</cite>
        </figcaption>

        <span aria-hidden="true" class="estudo-aspas estudo-aspas--fecha">”</span>
      </figure>
    </Container>
  </Section>

  <SiteFooter />

</BaseLayout>

<style>
  /* Item da lista de serviços: o ponto do marcador sai daqui e nao de
     list-disc, pelo motivo do balanceamento de coluna que o template
     documenta. O ::before precisa de content:'' explicito — sem ele o
     pseudo-elemento nao e gerado. O top de 0.55em e o que centraliza um disco
     de 4px na altura da linha do text-base com leading-relaxed, o mesmo
     truque do mt-2 das listas de segurca. */
  .estudo-servico {
    position: relative;
    padding-left: 1rem;
    margin-bottom: 0.5rem;
    break-inside: avoid;
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.625;
    color: var(--color-ink);
  }

  .estudo-servico::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 9999px;
    background-color: var(--color-accent-500);
  }

  /* Nome da empresa grifado dentro do depoimento: navy do primary-500 e o
     mesmo do contorno, e sem itálico porque o desenho grifa a empresa em
     redonda dentro do texto corrido. */
  .estudo-depoimento .destaque {
    font-style: normal;
    font-weight: 600;
    color: var(--color-primary-500);
  }

  /* Contorno do depoimento. As duas aspas ficam transbordando fora da caixa
     (topo esquerdo e base direita), como no desenho, e por isso o Section
     precisa de respiro vertical para elas nao serem cortadas pelo Container —
     foi o que segurou py-16 em vez do py-24 do tamanho xl. */
  .estudo-depoimento {
    position: relative;
    border: 2px solid var(--color-primary-500);
    border-radius: var(--radius-2xl);
    padding: 3rem 2rem;
  }

  /* As aspas sao <span aria-hidden> no template, e nao ::before/::after com
     content: o minificador de CSS do Vite transforma o escape unicode
     ('\201C') em aspas literais e a declaracao sai como """ — invalida, e
     junto com ela morre a regra inteira do pseudo-elemento. O fundo no token
     surface e o que recorta a linha do contorno atras da aspa. */
  .estudo-aspas {
    position: absolute;
    font-family: var(--font-display);
    font-size: 5rem;
    line-height: 1;
    font-weight: 700;
    color: var(--color-primary-500);
    background-color: var(--color-surface);
    padding: 0 0.5rem;
  }

  .estudo-aspas--abre {
    top: -1.75rem;
    left: 1rem;
  }

  .estudo-aspas--fecha {
    bottom: -1.75rem;
    right: 1rem;
  }

  @media (width >= 48rem) {
    .estudo-depoimento {
      padding: 3.5rem 4rem;
    }
  }

  /* No mobile o texto do depoimento fica espremido nas laterais de um
     contorno de 2px com as aspas transbordando em cima: o padding cai e as
     aspas encolhem. */
  @media (width < 40rem) {
    .estudo-depoimento {
      padding: 2.25rem 1.5rem;
    }

    .estudo-aspas {
      font-size: 3.5rem;
    }
  }
</style>