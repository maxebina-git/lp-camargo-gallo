    window.gsap.registerPlugin(window.ScrollTrigger);
    var section = document.getElementById('trust-cards-desktop');
    if (!section) return;
    var container = section.querySelector('.trust-card-container');
    var cards = section.querySelectorAll('.trust-card');
    var initialRots = [15, 5, -5, -15];
    window.gsap.fromTo(container,
      { x: '20vw' },
      { x: '-20vw', ease: 'none',
        scrollTrigger: { trigger: section, start: 'top bottom', end: 'bottom top', scrub: 1 } }
    );
    window.ScrollTrigger.create({
      trigger: section,
      start: 'top bottom',
      end: 'bottom top',
      scrub: 1,
      onUpdate: function(self) {
        var p = self.progress;
        cards.forEach(function(card, i) {
          var init = initialRots[i];
          var r = 0;
          if (p < 0.5) {
            r = init * (1 - p * 2);
          } else {
            r = -15 * (p * 2 - 1);
          }
          card.style.transform = 'rotate(' + r + 'deg)';
        });
      }
    });
  });
  </script>

  <script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof window.gsap === 'undefined' || typeof window.ScrollTrigger === 'undefined') return;
    window.gsap.registerPlugin(window.ScrollTrigger);
    var antesImg = document.getElementById('img-antes');
    var depoisImg = document.getElementById('img-depois');
    var fill = document.getElementById('before-after-fill');
    var thumb = document.getElementById('before-after-thumb');
    if (!antesImg || !depoisImg || !fill || !thumb) return;
    var primary = getComputedStyle(document.body).getPropertyValue('--color-primary-600').trim();
    var tl = window.gsap.timeline({
      scrollTrigger: {
        trigger: '#antes-e-depois',
        start: 'top top',
        end: '+=250%',
        pin: true,
        scrub: 1
      }
    });
    tl.to({}, { duration: 0.4 }, 0)
      .to(antesImg, { opacity: 0, duration: 1.2, ease: 'none' }, 0.4)
      .to(depoisImg, { opacity: 1, duration: 1.2, ease: 'none' }, 0.4)
      .to(fill, { width: '100%', duration: 1.2, ease: 'none' }, 0.4)
      .to(thumb, { backgroundColor: primary, duration: 1.2, ease: 'none' }, 0.4)
      .to({}, { duration: 0.4 }, 1.6);
    var track = document.getElementById('before-after-track');
    var st = tl.scrollTrigger;
    function thumbXForProgress(p) {
      var maxX = track.clientWidth - thumb.offsetWidth;
      if (p <= 0.2) return 0;
      if (p >= 0.8) return maxX;
      return (p - 0.2) / 0.6 * maxX;
    }
    if (track && st) {
      var dragging = false;
      function clampX(x) {
        return Math.max(0, Math.min(track.clientWidth - thumb.offsetWidth, x));
      }
      function xToProgress(x) {
        var maxX = track.clientWidth - thumb.offsetWidth;
        if (maxX <= 0) return 0;
        return Math.max(0, Math.min(1, x / maxX));
      }
      function syncThumb() {
        thumb.style.left = thumbXForProgress(tl.progress()) + 'px';
      }
      tl.eventCallback('onUpdate', function() {
        if (!dragging) syncThumb();
      });
      function seekTo(x) {
        var p = xToProgress(clampX(x));
        thumb.style.left = clampX(x) + 'px';
        tl.progress(p, true);
        window.scrollTo(0, st.start + p * (st.end - st.start));
      }
      thumb.addEventListener('pointerdown', function(e) {
        dragging = true;
        thumb.setPointerCapture(e.pointerId);
      });
      thumb.addEventListener('pointermove', function(e) {
        if (!dragging) return;
        var rect = track.getBoundingClientRect();
        var x = clampX(e.clientX - rect.left - thumb.offsetWidth / 2);
        thumb.style.left = x + 'px';
        tl.progress(xToProgress(x), true);
      });
      function onDragEnd() {
        if (!dragging) return;
        dragging = false;
        seekTo(parseFloat(thumb.style.left) || 0);
      }
      thumb.addEventListener('pointerup', onDragEnd);
      thumb.addEventListener('pointercancel', onDragEnd);
      track.addEventListener('click', function(e) {
        if (dragging || e.target === thumb) return;
        var rect = track.getBoundingClientRect();
        seekTo(e.clientX - rect.left - thumb.offsetWidth / 2);
      });
    }
  });
  </script>

