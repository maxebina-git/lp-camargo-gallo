  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
  <script is:inline>
    gsap.registerPlugin(ScrollTrigger);
    const img = document.getElementById('sequence-img');
    const minFrame = 2;
    const maxFrame = 50;
    let currentFrame = 2;
    const proxy = { progress: 0 };
    function frameSrc(n) {
      return '/assets/frames/' + String(n).padStart(3, '0') + '.png';
    }
    for (let i = minFrame; i <= maxFrame; i++) {
      const preload = new Image();
      preload.src = frameSrc(i);
    }
    const cards = document.querySelectorAll('.orbit-card');
    const totalCards = cards.length;
    const queueStart = 8;
    const queueStagger = 0.08;
    const freezePoint = (totalCards - queueStart) * queueStagger;
    const phases = [
      { from: { x: 90, y: 85 }, to: { x: 10, y: 85 } },
      { from: { x: 10, y: 85 }, to: { x: 10, y: 18 } },
      { from: { x: 10, y: 18 }, to: { x: 90, y: 18 } },
      { from: { x: 90, y: 18 }, to: { x: 90, y: 85 } },
      { from: { x: 90, y: 85 }, to: { x: 90, y: 110 } },
    ];
    const totalPhases = phases.length;
    function interpolatePath(p) {
      if (p < 0) return null;
      if (p >= 1) return { x: 90, y: 110 + (p - 1) * 100 };
      const segmentFloat = p * totalPhases;
      const segmentIndex = Math.min(Math.floor(segmentFloat), totalPhases - 1);
      const t = Math.min(segmentFloat - segmentIndex, 1);
      const from = phases[segmentIndex].from;
      const to = phases[segmentIndex].to;
      return { x: from.x + (to.x - from.x) * t, y: from.y + (to.y - from.y) * t };
    }
    function isOnScreen(x, y) { return x >= -5 && x <= 105 && y >= -5 && y <= 105; }
    function getCardZIndex(x) { return x > 95 ? 1 : 20; }
    function initCards() {
      for (let i = 0; i < totalCards; i++) {
        const card = cards[i];
        if (i < queueStart) {
          const offset = (i / queueStart) * 0.8;
          const pos = interpolatePath(offset);
          if (pos && isOnScreen(pos.x, pos.y)) {
            gsap.set(card, { xPercent: -50, yPercent: -50, left: pos.x + '%', top: pos.y + '%', zIndex: getCardZIndex(pos.x), display: 'block' });
          } else { gsap.set(card, { display: 'none' }); }
        } else {
          gsap.set(card, { xPercent: -50, yPercent: -50, left: '115%', top: '85%', zIndex: 1, display: 'none' });
        }
      }
    }
    initCards();
    ScrollTrigger.create({
      trigger: '#scroll-wrapper',
      start: 'top top',
      end: 'bottom bottom',
      scrub: 1,
      onUpdate: (self) => {
        const globalProgress = self.progress;
        const orbitProgress = globalProgress * freezePoint;
        gsap.to(proxy, {
          progress: globalProgress, duration: 0.3, ease: 'power2.out', overwrite: true,
          onUpdate: () => {
            const frame = Math.round(proxy.progress * (maxFrame - minFrame)) + minFrame;
            if (frame !== currentFrame) { currentFrame = frame; img.src = frameSrc(frame); }
          }
        });
        for (let i = 0; i < totalCards; i++) {
          const card = cards[i];
          if (i < queueStart) {
            const offset = (i / queueStart) * 0.8;
            const cardP = offset + orbitProgress;
            const pos = interpolatePath(cardP);
            const fadeStart = freezePoint - 0.05;
            const isFadingCard5 = i === 3;
            let opacity = 1;
            if (isFadingCard5 && orbitProgress >= fadeStart) opacity = Math.max(0, 1 - (orbitProgress - fadeStart) / 0.05);
            if (pos && isOnScreen(pos.x, pos.y) && pos.y <= 87) {
              card.style.display = 'block';
              gsap.set(card, { xPercent: -50, yPercent: -50, left: pos.x + '%', top: pos.y + '%', zIndex: getCardZIndex(pos.x), opacity: opacity });
            } else { card.style.display = 'none'; card.style.opacity = 1; }
          } else {
            const queueIndex = i - queueStart;
            const entryThreshold = (queueIndex + 1) * queueStagger;
            if (orbitProgress < entryThreshold) { card.style.display = 'none'; }
            else {
              const elapsed = orbitProgress - entryThreshold;
              const pos = interpolatePath(elapsed);
              if (pos && isOnScreen(pos.x, pos.y) && pos.y <= 87) {
                card.style.display = 'block';
                gsap.set(card, { xPercent: -50, yPercent: -50, left: pos.x + '%', top: pos.y + '%', zIndex: getCardZIndex(pos.x) });
              } else { card.style.display = 'none'; }
            }
          }
        }
      }
    });
  </script>
  <script is:inline>
    function animarScroll() {
      const el = document.getElementById('titulo-orcamento');
      if (!el) return;
      const target = el.getBoundingClientRect().top + window.scrollY - 20;
      gsap.to({ y: window.scrollY }, {
        y: target,
        duration: 4,
        ease: "power5.out",
        onUpdate: function () {
          window.scrollTo(0, this.targets()[0].y);
        }
      });
    }
    function formatarTelefone(inp) {
      let v = inp.value.replace(/\D/g, '').slice(0, 11);
      if (v.length > 7) v = v.replace(/(\d{2})(\d{5})(\d{4})/, '($1) $2-$3');
      else if (v.length > 2) v = v.replace(/(\d{2})(\d+)/, '($1) $2');
      inp.value = v;
    }
    function formatarEmail(inp) {
      inp.value = inp.value.replace(/[^a-zA-Z0-9.@]/g, '');
    }
    function validarFormulario(e) {
      e.preventDefault();
      document.getElementById('erro-nome').classList.add('hidden');
      document.getElementById('erro-whatsapp').classList.add('hidden');
      document.getElementById('erro-email').classList.add('hidden');
      document.getElementById('erro-mensagem').classList.add('hidden');
      const wh = document.getElementById('whatsapp').value.replace(/\D/g, '');
      const em = document.getElementById('email').value.trim();
      let ok = true;
      if (wh.length !== 11) { document.getElementById('erro-whatsapp').classList.remove('hidden'); ok = false; }
      if (!/^[a-zA-Z0-9]+@[a-zA-Z0-9]+\.[a-zA-Z]{2,}$/.test(em)) { document.getElementById('erro-email').classList.remove('hidden'); ok = false; }
      const nome = document.getElementById('nome').value.trim();
      if (nome.length === 0) { document.getElementById('erro-nome').classList.remove('hidden'); ok = false; }
      const msg = document.getElementById('mensagem').value.trim();
      if (msg.length === 0) { document.getElementById('erro-mensagem').classList.remove('hidden'); ok = false; }
      if (ok) alert('Lead enviado — integrar backend');
    }
  </script>

