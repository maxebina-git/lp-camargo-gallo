---
import BaseLayout from '../layouts/BaseLayout.astro'
import {
  Button,
  Container,
  Heading,
  Section,
  Reveal,
  IconSet,
  BackToTop,
  BrandIcon,
} from 'ds-grupo-rkb'
import SiteHeader from '../components/layout/SiteHeader.astro'
import SiteFooter from '../components/layout/SiteFooter.astro'
import WhatsappButton from '../components/WhatsappButton.vue'
import HeroSlider from '../components/hero/HeroSlider.vue'
import AboutSection from '../components/about/AboutSection.astro'
import PortfolioSection from '../components/portfolio/PortfolioSection.astro'
import ServiceCard from '../components/services/ServiceCard.vue'
import FaqSection from '../components/faq/FaqSection.vue'
import { servicos } from '../data/servicos'
import { headerNavHome } from '../data/site'
import lucide from '@lucide/vue'
const { ChevronUp } = lucide
---

<style>
  .servico-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
  }
  .servico-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .servico-reveal,
    .servico-reveal.is-visible {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<BaseLayout title="Restauração de Fachadas e Pintura Predial em SP | Camargo Gallo Engenharia" description="Especialistas em reforma de fachadas, impermeabilização e pintura predial em São Paulo. Solicite um orçamento com a Camargo Gallo Engenharia e garanta a valorização do seu patrimônio.">

  <SiteHeader nav={headerNavHome} spacer={false} />

  <HeroSlider client:load />

  <AboutSection />

  <Section tone="surface-alt" id="servicos" class="py-16">
    <Container size="lg">
      <Reveal client:visible>
        <div class="flex flex-col items-center text-center mb-12 gap-3">
          <div role="separator" aria-hidden="true" class="h-4 w-1/2 rounded-full bg-border"></div>
          <Heading as="2" size="display" class="section-title mt-3">Serviços completos de ponta a ponta</Heading>
          <Heading as="3" size="xl" class="text-deep">Do diagnóstico à pintura premium — acompanhamento online e conformidade NR-35.</Heading>
        </div>
      </Reveal>
      <div class="relative">
        <div class="servicos-slider flex gap-6 overflow-x-auto snap-x snap-mandatory [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" role="region" aria-label="Serviços">
          <div class="servicos-track flex gap-6" data-servicos-track>
            {servicos.map((s) => (
              <div class="servico-item servico-reveal shrink-0 snap-start">
                <ServiceCard titulo={s.titulo} imagem={s.imagem} href={s.href} />
              </div>
            ))}
          </div>
        </div>
        <button
          data-servicos-prev
          class="absolute left-3 top-1/2 -translate-y-1/2 z-10 flex h-11 w-11 cursor-pointer items-center justify-center rounded-full bg-white/90 text-ink shadow-lg backdrop-blur transition hover:bg-white"
          aria-label="Serviço anterior"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button
          data-servicos-next
          class="absolute right-3 top-1/2 -translate-y-1/2 z-10 flex h-11 w-11 cursor-pointer items-center justify-center rounded-full bg-white/90 text-ink shadow-lg backdrop-blur transition hover:bg-white"
          aria-label="Próximo serviço"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
      <div class="flex justify-center mt-12">
        <Button as="a" href="#" variant="secondary" size="lg">Ver + Serviços</Button>
      </div>
    </Container>
  </Section>
  
  <PortfolioSection />

  <Section tone="warm" id="insights" class="py-16">
    <Container size="lg">
      <Reveal client:visible>
        <div class="flex flex-col items-center text-center mb-12 gap-3">
          <div role="separator" aria-hidden="true" class="h-4 w-1/2 rounded-full bg-divider"></div>
          <Heading as="2" size="display" class="section-title mt-3">Insights</Heading>
          <Heading as="3" size="xl" class="text-deep">Da identificação de patologias às soluções preventivas — insight antecipado para proteção duradoura</Heading>
        </div>
      </Reveal>
      <div class="relative">
        <div id="insights-container" class="servicos-slider flex gap-6 overflow-x-auto snap-x snap-mandatory [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" role="region" aria-label="Insights">
          <div class="servicos-track flex gap-6" data-servicos-track>
            <!-- Renderizado dinamicamente via JS -->
          </div>
        </div>
        <button
          data-servicos-prev
          class="absolute left-3 top-1/2 -translate-y-1/2 z-10 flex h-11 w-11 cursor-pointer items-center justify-center rounded-full bg-white/90 text-ink shadow-lg backdrop-blur transition hover:bg-white"
          aria-label="Insight anterior"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button
          data-servicos-next
          class="absolute right-3 top-1/2 -translate-y-1/2 z-10 flex h-11 w-11 cursor-pointer items-center justify-center rounded-full bg-white/90 text-ink shadow-lg backdrop-blur transition hover:bg-white"
          aria-label="Próximo insight"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
      <div class="flex justify-center mt-12">
        <Button as="a" href="/insights" variant="primary" size="lg">Ver + Insights</Button>
      </div>
    </Container>
  </Section>

  <script is:inline>
    (function () {
      function esc(value) {
        return String(value == null ? '' : value).replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }

      function formatDateBR(value) {
        var parts = String(value || '').split('-');
        if (parts.length !== 3) return String(value || '');
        return parts[2] + '/' + parts[1] + '/' + parts[0];
      }

      function createInsightHTML(item) {
        var href = '/insights/' + encodeURIComponent(item.slug || item.id);
        var thumb = item.imagem
          ? '<img src="' + esc(item.imagem) + '" alt="' + esc(item.titulo) + '" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />'
          : '<div class="flex h-full w-full items-center justify-center bg-deep/5 text-deep/40" aria-hidden="true">' +
            '<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>' +
            '</div>';

        return `
          <div class="servico-item servico-reveal shrink-0 snap-start">
            <a href="${href}" class="block group w-[300px] h-[400px] flex flex-col">
              <div class="relative h-[240px] overflow-hidden rounded-xl bg-surface-alt mb-4">
                ${thumb}
                <div class="absolute top-3 left-3">
                  <span class="bg-white/90 backdrop-blur px-2 py-1 rounded text-[10px] font-bold uppercase tracking-wider text-ink shadow-sm">${esc(item.categoria || 'Geral')}</span>
                </div>
              </div>
              <div class="flex flex-col gap-2 flex-1 min-h-0">
                <span class="text-xs font-body text-deep/60">${esc(formatDateBR(item.data))}</span>
                <h3 class="text-lg font-bold text-ink group-hover:text-primary transition-colors">${esc(item.titulo)}</h3>
                <p class="text-sm font-body text-deep/80 line-clamp-2">${esc(item.resumo)}</p>
              </div>
            </a>
          </div>
        `;
      }

      async function loadInsights() {
        var track = document.querySelector('#insights-container [data-servicos-track]');
        if (!track) return;

        try {
          var response = await fetch('/api/public/insights.php');
          if (!response.ok) throw new Error('HTTP ' + response.status);
          var data = await response.json();
          if (!Array.isArray(data)) throw new Error('resposta inesperada da API');

          if (!data.length) {
            track.innerHTML = '<p class="w-full py-8 text-center text-sm text-deep/60 font-body">Nenhum insight publicado ainda.</p>';
            return;
          }

          track.innerHTML = data.map(createInsightHTML).join('');
          initSliders();
        } catch (e) {
          console.error('Erro ao carregar insights dinamicos:', e);
          track.innerHTML = '<p class="w-full py-8 text-center text-sm text-deep/60 font-body">Nao foi possivel carregar os insights.</p>';
        }
      }

      function setup(slider, track, prev, next) {
        if (!slider || !track || !prev || !next) return;

        var total = track.children.length;
        if (total < 2) return;

        var realStart = 0;
        var realEnd = total - 1;
        var slides = [];
        var locked = false;
        var touched = false;
        var unlockTimer = null;

        function itemBox(el) {
          var rect = el.getBoundingClientRect();
          if (rect.width) return rect;
          var inner = el.querySelector('.servico-item');
          return inner ? inner.getBoundingClientRect() : rect;
        }

        function makeClone(el) {
          var src = el.classList.contains('servico-item') ? el : (el.querySelector('.servico-item') || el);
          var node = document.createElement('div');
          node.className = 'servico-item servico-clone shrink-0 snap-start';
          Array.prototype.forEach.call(src.childNodes, function (child) {
            node.appendChild(child.cloneNode(true));
          });
          node.setAttribute('aria-hidden', 'true');
          Array.prototype.forEach.call(node.querySelectorAll('a, button, [tabindex]'), function (focusable) {
            focusable.setAttribute('tabindex', '-1');
          });
          return node;
        }

        function observeReveal() {
          if (!('IntersectionObserver' in window)) {
            Array.prototype.forEach.call(track.children, function (el) {
              if (!el.classList.contains('servico-clone')) el.classList.add('is-visible');
            });
            return;
          }

          var observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              entry.target.classList.toggle('is-visible', entry.isIntersecting);
            });
          }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });

          Array.prototype.forEach.call(track.children, function (el) {
            if (!el.classList.contains('servico-clone')) observer.observe(el);
          });
        }

        function build() {
          Array.prototype.slice.call(track.children).forEach(function (el) {
            if (el.classList.contains('servico-clone')) el.remove();
          });

          var originals = Array.prototype.slice.call(track.children);
          var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
          var width = itemBox(originals[0]).width || itemBox(originals[originals.length - 1]).width || 300;
          var step = width + gap || 1;

          var visible = Math.ceil(slider.clientWidth / step) + 1;
          var before = originals.slice(Math.max(0, originals.length - visible));
          var anchor = track.firstChild;

          before.forEach(function (el) { track.insertBefore(makeClone(el), anchor); });
          originals.slice(0, visible).forEach(function (el) { track.appendChild(makeClone(el)); });

          realStart = before.length;
          realEnd = realStart + originals.length - 1;
          slides = Array.prototype.slice.call(track.children);
        }

        function jumpTo(x) {
          slider.scrollLeft = x;
        }

        function positions() {
          var left = slider.getBoundingClientRect().left;
          var base = slider.scrollLeft;
          return slides.map(function (el) {
            return base + (itemBox(el).left - left);
          });
        }

        function nearestIndex() {
          var pos = positions();
          var x = slider.scrollLeft;
          var best = 0;
          var dist = Infinity;
          for (var i = 0; i < pos.length; i++) {
            var d = Math.abs(pos[i] - x);
            if (d < dist) { dist = d; best = i; }
          }
          return best;
        }

        function toReal(i) {
          if (i > realEnd) return realStart + ((i - realStart) % total);
          if (i < realStart) return realStart + ((((i - realStart) % total) + total) % total);
          return i;
        }

        function settle() {
          var i = nearestIndex();
          var real = toReal(i);
          if (real !== i) jumpTo(positions()[real]);
          return real - realStart;
        }

        function unlock() {
          locked = false;
          if (unlockTimer) { clearTimeout(unlockTimer); unlockTimer = null; }
        }

        function waitScroll() {
          locked = true;
          if (unlockTimer) clearTimeout(unlockTimer);
          var done = false;
          function finish() {
            if (done) return;
            done = true;
            slider.removeEventListener('scrollend', finish);
            unlock();
            settle();
          }
          slider.addEventListener('scrollend', finish, { once: true });
          unlockTimer = setTimeout(finish, 900);
        }

        function stepBy(delta) {
          if (locked) return;
          waitScroll();
          var i = nearestIndex() + delta;
          i = Math.max(0, Math.min(slides.length - 1, i));
          slider.scrollTo({ left: positions()[i], behavior: 'smooth' });
        }

        function currentCard() {
          return toReal(nearestIndex()) - realStart;
        }

        function reposition(keep) {
          build();
          jumpTo(positions()[realStart + keep]);
        }

        reposition(0);
        observeReveal();
        window.addEventListener('load', function () {
          if (!touched) reposition(currentCard());
        });

        prev.addEventListener('click', function () { touched = true; stepBy(-1); });
        next.addEventListener('click', function () { touched = true; stepBy(1); });

        var idle = null;
        slider.addEventListener('scroll', function () {
          if (locked) return;
          if (idle) clearTimeout(idle);
          idle = setTimeout(settle, 160);
        }, { passive: true });

          var resizeTimer = null;
          window.addEventListener('resize', function () {
            if (resizeTimer) clearTimeout(resizeTimer);
            resizeTimer = setTimeout(function () { reposition(currentCard()); }, 200);
          });

          slider.setAttribute('data-slider-ready', '1');
        }

        function initSliders() {
          Array.prototype.forEach.call(document.querySelectorAll('.servicos-slider'), function (sl) {
            if (sl.getAttribute('data-slider-ready') === '1') return;
            setup(
              sl,
              sl.querySelector('[data-servicos-track]'),
              sl.parentElement.querySelector('[data-servicos-prev]'),
              sl.parentElement.querySelector('[data-servicos-next]')
            );
          });
        }

      initSliders();
      loadInsights();
    })();
  </script>

  <FaqSection client:load />

  <SiteFooter />

  <BackToTop client:load>
    <IconSet size="24"><ChevronUp /></IconSet>
  </BackToTop>

  <WhatsappButton client:load />
</BaseLayout>
