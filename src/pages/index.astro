  <LegalDrawer client:load />

  <script is:inline>
    document.addEventListener('click', function (event) {
      var anchor = event.target.closest('a[href="#privacy"], a[href="#terms"]');
      if (!anchor) return;
      event.preventDefault();
      var target = anchor.getAttribute('href');
      if (target === '#privacy' || target === '#terms') {
        if (location.hash === target) {
          history.replaceState(null, '', location.pathname + location.search);
        } else {
          location.hash = target;
        }
      }
    });
  </script>

  <script is:inline>
    function animarScroll() {
      const el = document.getElementById('titulo-orcamento');
      if (!el) return;
      const target = el.getBoundingClientRect().top + window.scrollY - 20;
      gsap.to({ y: window.scrollY }, {
        y: target,
        duration: 1.5,
        ease: "power3.out",
        onUpdate: function () {
          window.scrollTo(0, this.targets()[0].y);
        }
      });
    }
    
    function formatarTelefone(inp) {
      let v = inp.value.replace(/\D/g, '').slice(0, 11);
      if (v.length > 7) v = v.replace(/(\d{2})(\d{5})(\d{4})/, '($1) $2-$3');
      else if (v.length > 2) v = v.replace(/(\d{2})(\d+)/, '($1) $2');
      inp.value = v;
    }
    
    function submeterForm(e) {
      e.preventDefault();
      document.getElementById('erro-nome').classList.add('hidden');
      document.getElementById('erro-whatsapp').classList.add('hidden');
      document.getElementById('erro-email').classList.add('hidden');
      document.getElementById('erro-mensagem').classList.add('hidden');
      
      const wh = document.getElementById('whatsapp').value.replace(/\D/g, '');
      const em = document.getElementById('email').value.trim();
      let ok = true;
      
      if (wh.length !== 11) { document.getElementById('erro-whatsapp').classList.remove('hidden'); ok = false; }
      if (!/^[^\s@]+@[^\s@]+\.[a-zA-Z]{2,}(\.[a-zA-Z]{2,})?$/.test(em)) { document.getElementById('erro-email').classList.remove('hidden'); ok = false; }
      
      const nome = document.getElementById('nome').value.trim();
      if (nome.length === 0 || nome.length < 3) { document.getElementById('erro-nome').classList.remove('hidden'); ok = false; }
      
      const msg = document.getElementById('mensagem').value.trim();
      if (msg.length === 0 || msg.length < 10) { document.getElementById('erro-mensagem').classList.remove('hidden'); ok = false; }
      
      if (!ok) return;
      
      const btn = document.getElementById('submit-btn');
      btn.disabled = true;
      btn.innerHTML = '<span class="inline w-4 h-4 mr-2"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></span> Enviando...';
      
      document.getElementById('form-feedback').classList.add('hidden');
      document.getElementById('form-feedback').classList.remove('text-error-500');
      document.getElementById('form-feedback').classList.remove('text-green-600');
      
      const form = document.getElementById('contato-form');
      const formData = new FormData(form);
      
      fetch('/lp-camargo-gallo/send-email.php', { method: 'POST', body: formData })
        .then(r => r.text())
        .then(text => {
          if (text.trim() === 'OK') {
            gtag('event', 'lp_form_submit', { 'event_category': 'contato', 'event_label': 'form_lp' });
            document.getElementById('form-feedback').classList.remove('hidden');
            form.reset();
            document.getElementById('erro-nome').classList.add('hidden');
            document.getElementById('erro-whatsapp').classList.add('hidden');
            document.getElementById('erro-email').classList.add('hidden');
            document.getElementById('erro-mensagem').classList.add('hidden');
            
            const btn = document.getElementById('submit-btn');
            btn.disabled = false;
            btn.innerHTML = '<span class="inline w-4 h-4 mr-2"><svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></span> Enviar mensagem';
          }
        })
        .catch(() => {
          // erro silencioso; validações individuais já mostram problemas nos inputs
        });
    }
  </script>

  <BackToTop client:load>
    <IconSet size="24"><ChevronUp /></IconSet>
  </BackToTop>

  <WhatsappButton client:load />
</BaseLayout>
