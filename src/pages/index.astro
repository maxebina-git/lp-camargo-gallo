            </FormField>
            <FormField label="Email" id="email">
              <Input id="email" name="email" type="email" placeholder="seu@email.com.br" oninput="if(this.value.trim()){ if(/^[^\s@]+@[^\s@]+\.[a-zA-Z]{2,}(\.[a-zA-Z]{2,})?$/.test(this.value.trim())) document.getElementById('erro-email').classList.add('hidden'); else document.getElementById('erro-email').classList.remove('hidden'); } else { document.getElementById('erro-email').classList.remove('hidden'); }" />
              <p id="erro-email" class="text-error-500 text-sm hidden mt-1">Informe um email válido.</p>
            </FormField>
            <FormField label="Mensagem" id="mensagem">
              <Textarea id="mensagem" name="mensagem" placeholder="Conte sobre sua fachada" rows={4} oninput="if(this.value.trim().length>=10) document.getElementById('erro-mensagem').classList.add('hidden')" />
              <p id="erro-mensagem" class="text-error-500 text-sm hidden mt-1">Campo obrigatório.</p>
            </FormField>
            <div id="form-feedback" class="hidden text-green-600 text-sm font-medium mb-2">Mensagem enviada com sucesso!</div>
            <div class="flex items-center gap-4">
