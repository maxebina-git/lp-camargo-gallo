---
import BaseLayout from '../layouts/BaseLayout.astro'
import {
  Button,
  Tag,
  Container,
  FormField,
  Input,
  Textarea,
  Heading,
  Text,
  Section,
  Reveal,
  Card,
  FeatureCard,
  IconSet,
  BackToTop,
  Header,
  BrandIcon,
  Footer,
} from 'ds-grupo-rkb'
import LegalDrawer from '../components/legal/LegalDrawer.vue'
import FaqSection from '../components/faq/FaqSection.vue'
import WhatsappButton from '../components/WhatsappButton.vue'
import lucide from '@lucide/vue'
const { LucideMail, ChevronUp, Shield, HardHat, ScanLine, Smartphone } = lucide

const servicos = [
  { titulo: 'Recuperação de Fachadas com Pintura ou Textura Acrílica', texto: 'Tratamento de fissuras, trincas e falhas de aderência com fundos preparadores, membranas de proteção e acabamento em pintura ou textura acrílica de alto desempenho.' },
  { titulo: 'Recuperação Total de Fachadas com Revestimento Cerâmico', texto: 'Remoção integral do revestimento existente, recuperação da base e execução de novo sistema cerâmico com juntas de movimentação e detalhes técnicos completos.' },
  { titulo: 'Conversão de Fachadas Cerâmicas para Texturizadas', texto: 'Remoção completa da cerâmica, tratamento da base e execução de novo sistema com textura acrílica, proporcionando renovação estética e redução de cargas.' },
  { titulo: 'Restauração Localizada de Fachadas Cerâmicas', texto: 'Recuperação de trechos com desprendimentos ou perda de aderência, buscando compatibilidade técnica e estética com o revestimento existente.' },
  { titulo: 'Sobreposição de Fachadas Cerâmicas com Textura Acrílica', texto: 'Preparação do revestimento existente e execução de novo sistema argamassado com acabamento texturizado, quando as condições técnicas permitem a sobreposição.' },
  { titulo: 'Recuperação de Fachadas em Concreto Aparente', texto: 'Tratamento de fissuras, corrosão de armaduras e recomposição do concreto com sistemas de proteção que preservam as características arquitetônicas originais.' },
  { titulo: 'Recuperação de Fachadas em Tijolos Aparentes', texto: 'Tratamento de fissuras, juntas e falhas de assentamento com limpeza e recuperação localizada. Proteção final com hidrofugantes ou resinas acrílicas.' },
  { titulo: 'Recuperação de Revestimentos Minerais e Monocapa', texto: 'Recuperação de fissuras e falhas com revestimentos compatíveis com o sistema original. Aplicação de hidrofugante para reduzir absorção de água sem pintura.' },
  { titulo: 'Tratamento de Áreas com Som Cavo por Injeção', texto: 'Recuperação de regiões com perda de aderência através de injeção de materiais específicos, restabelecendo a aderência sem remoção integral do revestimento.' },
  { titulo: 'Recuperação Estrutural de Concreto Armado', texto: 'Tratamento de armaduras corroídas, recomposição de seções de concreto e aplicação de argamassas estruturais, grout e sistemas de reparo e reforço.' },
  { titulo: 'Impermeabilização de Lajes e Reservatórios', texto: 'Remoção de sistemas existentes, preparação da base, correção de caimentos e execução de novos sistemas de impermeabilização com testes de estanqueidade.' },
]

const diferenciais = [
  { icone: Shield, titulo: 'Seguro de R$ 10 Milhões', texto: 'Responsabilidade Civil para total proteção da obra.' },
  { icone: HardHat, titulo: '+200 Colaboradores', texto: 'Equipe técnica com 10 engenheiros especialistas.' },
  { icone: ScanLine, titulo: 'Drones e Termografia', texto: 'Inspeção avançada para identificar anomalias.' },
  { icone: Smartphone, titulo: 'Gestão em Tempo Real', texto: 'Plataforma com reconhecimento facial e RDOs.' },
]

const footerCompany = {
  companyName: 'CAMARGO GALLO ENGENHARIA LTDA',
  cnpj: '23.741.090/0001-77',
  address: 'Rua Maria Jose Rangel, 159 - Vila São Paulo, São Paulo/SP - CEP 04650-180',
  contacts: [
    { label: '(11) 2924-8556', href: 'tel:+551129248556', icon: 'phone' as const },
    { label: 'WhatsApp', href: 'https://wa.me/551129248556?text=Ol%C3%A1%20gostaria%20de%20saber%20mais%20sobre%20recupera%C3%A7%C3%A3o%20de%20fachadas', icon: 'whatsapp' as const },
  ],
  legalLinks: [
    { label: 'Política de Privacidade', href: '#privacy' },
    { label: 'Termos de Uso', href: '#terms' },
  ],
}

const headerNav = [
  { label: 'EMPRESA', href: '#' },
  { label: 'SERVIÇOS', href: '#servicos' },
  {
    label: 'ESTUDOS DE CASO',
    href: '#estudo-de-caso',
    parentLink: true,
    dropdown: [
      { label: 'Revitalização de fachadas e áreas comuns', href: '#estudo-de-caso' },
      { label: 'Retrofit de fachadas e áreas comuns', href: '#estudo-de-caso' },
      { label: 'Pintura de fachadas e áreas comuns', href: '#estudo-de-caso' },
      { label: 'Impermeabilização de lajes de cobertura', href: '#estudo-de-caso' },
    ],
  },
  { label: 'SEGURANÇA', href: '#' },
  { label: 'PARCEIROS', href: '#' },
  { label: 'PORTFÓLIO', href: '#' },
  { label: 'BLOG', href: '#' },
  { label: 'CONTATO', href: '#contato' },
];

---

<style>
  .tag-amber { color: var(--color-material-amber-500); background-color: var(--color-material-amber-500); }
</style>

<BaseLayout title="Restauração de Fachadas e Pintura Predial em SP | Camargo Gallo Engenharia" description="Especialistas em reforma de fachadas, impermeabilização e pintura predial em São Paulo. Solicite um orçamento com a Camargo Gallo Engenharia e garanta a valorização do seu patrimônio.">

  <Header client:load boxed size="lg" position="fixed" nav={headerNav}>
    <Button
      slot="aside"
      iconOnly
      size="lg"
      as="a"
      href="https://wa.me/551129248556?text=Ol%C3%A1%20gostaria%20de%20saber%20mais%20sobre%20recupera%C3%A7%C3%A3o%20de%20fachadas"
      aria-label="Falar no WhatsApp"
      class="bg-[#25D366]! text-white! hover:bg-[#128C7E]!"
    >
      <BrandIcon name="whatsapp" class="h-5 w-5" />
    </Button>
  </Header>

  <Section tone="surface-alt" size="none" class="relative z-0 flex min-h-[100svh] flex-row overflow-x-clip bg-[radial-gradient(ellipse_at_top,_#e6e7ef_0%,_#cccce0_100%)] max-lg:min-h-[100svh] max-lg:flex-col max-lg:pb-10 max-lg:pt-20 sm:max-lg:pb-12 sm:max-lg:pt-24 lg:h-[100dvh] lg:min-h-[100dvh] lg:pb-0 lg:pt-0">
    <Container class="flex w-full flex-1 flex-row py-0 max-lg:flex-col lg:h-full" size="lg">
      <div class="order-2 flex w-8/12 flex-none flex-col items-center justify-center px-4 text-center lg:h-full max-lg:order-1 max-lg:w-full max-lg:flex-1 max-lg:px-0">
        <div class="hero-content flex w-full flex-col items-center">
          <img src="/assets/logo-camargo-gallo.png" alt="Camargo Gallo" width="166" height="232" class="h-auto w-14 sm:w-16 lg:hidden max-[359px]:hidden" fetchpriority="high" decoding="async" />
          <div class="flex w-full flex-col items-center">
            <Heading as="1" size="display" class="hero-title text-center text-ink">Engenharia, Estrutura e Tecnologia para <span class="inline-block max-w-full font-extrabold text-deep">Grandes Intervenções em Fachadas<img src="/assets/decorative-underline.png" alt="" aria-hidden="true" class="-mt-1 block w-full max-w-full" /></span></Heading>
          </div>
          <Text as="p" size="lg" tone="default" class="hero-copy max-w-2xl">Especialistas em grandes intervenções em condomínios habitados. Unimos eficiência, segurança e mínimo impacto na rotina dos moradores para entregar soluções tecnicamente precisas e duráveis.</Text>
          <div class="flex w-full flex-row justify-center gap-3 max-sm:flex-col">
            <Button as="a" href="https://wa.me/551129248556?text=Ol%C3%A1%20gostaria%20de%20saber%20mais%20sobre%20recupera%C3%A7%C3%A3o%20de%20fachadas" target="_blank" rel="noopener noreferrer" onclick="gtag('event', 'lp_whatsapp_click', { 'event_category': 'contato', 'event_label': 'whatsapp_lp' });" variant="primary" size="lg" class="w-auto font-body max-sm:w-full">Solicitar Vistoria Técnica</Button>
            <Button variant="secondary" size="lg" onclick="gtag('event', 'lp_scroll_to_form', { 'event_category': 'navegacao', 'event_label': 'cta_formulario' }); animarScroll()" class="w-auto font-body max-sm:w-full">Escrever Mensagem</Button>
          </div>
        </div>
      </div>
      <div class="order-1 hidden w-4/12 flex-col items-center justify-center gap-6 px-4 lg:order-1 lg:flex">
        <img src="/assets/logo-camargo-gallo.png" alt="Camargo Gallo" width="166" height="232" class="h-auto w-[166px]" fetchpriority="high" decoding="async" />
        <div class="grid w-full max-w-[360px] grid-cols-2 gap-3">
          {diferenciais.map((d) => {
            const Icone = d.icone;
            return (
              <FeatureCard tone="deep" class="!p-3 text-center [&>div]:flex-1 [&>div]:justify-between">
                <div slot="title" class="flex flex-col items-center gap-2">
                  <span class="trust-icon text-[var(--color-divider)]"><Icone size="26" /></span>
                  <h3 class="text-sm font-bold leading-tight text-on-deep">{d.titulo}</h3>
                </div>
                <div slot="description" class="text-xs leading-snug">{d.texto}</div>
              </FeatureCard>
            );
          })}
        </div>
      </div>
    </Container>
  </Section>

  <Section id="trust-cards" size="lg" class="lg:hidden">
    <Container>
      <div class="mb-6 flex flex-col items-center text-center">
        <Heading as="2" size="2xl">Engenharia. Estrutura. Tecnologia.</Heading>
        <Text tone="secondary">Gatilhos de autoridade que respaldam cada obra.</Text>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {diferenciais.map((d) => {
          const Icone = d.icone;
          return (
            <Reveal client:visible class="h-full">
              <Card class="h-full" tone="surface">
                <div class="flex h-full flex-col items-center justify-center text-center">
                  <div class="trust-icon text-primary-500"><Icone size="32" /></div>
                  <h3 class="trust-card-title mt-4 text-lg sm:text-xl">{d.titulo}</h3>
                  <div role="separator" aria-hidden="true" class="my-4 h-1.5 w-1/2 rounded-full bg-primary-500"></div>
                  <p class="trust-card-description">{d.texto}</p>
                </div>
              </Card>
            </Reveal>
          );
        })}
      </div>
    </Container>
  </Section>

  <Section size="lg" id="servicos" class="py-16">
    <Container>
      <Reveal client:visible>
        <div class="flex flex-col items-center text-center mb-6 gap-3">
          <Tag class="tag-amber">11 Serviços</Tag>
          <Heading as="2" size="display">Serviços completos de ponta a ponta</Heading>
          <Text tone="secondary">Do diagnóstico à pintura premium — 14 etapas com acompanhamento online e conformidade NR-35.</Text>
        </div>
      </Reveal>
      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {servicos.map((s) => (
          <Reveal client:visible class="h-full">
            <FeatureCard tone="deep" class="h-full w-full">
              <h3 slot="title" class="font-display text-xl font-bold text-center">{s.titulo}</h3>
              <div slot="description" class="font-body text-sm leading-normal text-center">{s.texto}</div>
            </FeatureCard>
          </Reveal>
        ))}
      </div>
    </Container>
  </Section>

  <Section tone="surface-alt" size="lg" id="estudo-de-caso" class="py-16">
    <Container>
      <div class="grid gap-10 md:grid-cols-2 md:items-center">
        <div class="flex flex-col gap-4">
          <Heading as="2" size="2xl">Resultados que falam por si</Heading>
          <Heading as="3" size="xl">Condomínio Ilha do Sul, Morumbi</Heading>
          <Text tone="secondary">Recuperação completa de fachada de torre residencial com 25 pavimentos, incluindo tratamento de armaduras, recomposição de concreto e pintura acrílica de alto desempenho.</Text>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <figure class="m-0">
            <img src="/assets/foto-lp-antes.png" alt="Fachada do Condomínio Ilha do Sul antes da recuperação" class="aspect-[4/3] w-full rounded-lg object-cover" loading="lazy" />
            <figcaption class="mt-2 text-center text-sm text-text-secondary">Antes</figcaption>
          </figure>
          <figure class="m-0">
            <img src="/assets/foto-lp-depois.png" alt="Fachada do Condomínio Ilha do Sul depois da recuperação" class="aspect-[4/3] w-full rounded-lg object-cover" loading="lazy" />
            <figcaption class="mt-2 text-center text-sm text-text-secondary">Depois</figcaption>
          </figure>
        </div>
      </div>
    </Container>
  </Section>

  <div class="bg-surface-alt text-ink">
    <FaqSection client:load />
  </div>

  <section id="contato" class="bg-surface text-ink py-16">
    <Container>
      <div class="max-w-3xl mx-auto">
        <div class="flex flex-col gap-4 items-center text-center mb-12">
          <Heading as="2" size="2xl" id="titulo-orcamento">Solicite seu orçamento</Heading>
          <Text tone="secondary">Retorno em até 24h. Atendemos condomínios, indústrias e edifícios comerciais.</Text>
          <div class="flex flex-wrap items-center justify-center gap-3">
            <a href="tel:+551129248556" onclick="gtag('event', 'lp_phone_click', { 'event_category': 'contato', 'event_label': 'telefone_lp' });" class="flex items-center gap-2 font-body text-ink">
              (11) 2924-8556
            </a>
            <span class="opacity-50">|</span>
            <a href="https://wa.me/551129248556?text=Ol%C3%A1%20gostaria%20de%20saber%20mais%20sobre%20recupera%C3%A7%C3%A3o%20de%20fachadas" target="_blank" rel="noopener noreferrer" onclick="gtag('event', 'lp_whatsapp_click', { 'event_category': 'contato', 'event_label': 'whatsapp_lp' });" class="flex items-center gap-2 font-body text-ink">
              <BrandIcon name="whatsapp" class="h-4 w-4" /> WhatsApp
            </a>
            <span class="opacity-50">|</span>
            <a href="mailto:atendimento@camargogallo.com.br" onclick="gtag('event', 'lp_email_click', { 'event_category': 'contato', 'event_label': 'email_lp' });" class="flex items-center gap-2 font-body text-ink">
              <LucideMail class="w-4 h-4" /> atendimento@camargogallo.com.br
            </a>
          </div>
        </div>
        <Card>
          <form id="contato-form" class="flex flex-col gap-4" action="/lp-camargo-gallo/send-email.php" method="post" onsubmit="submeterForm(event)" novalidate>
            <FormField label="Nome" id="nome">
              <Input id="nome" name="nome" placeholder="Seu nome" oninput="if(this.value.trim().length>=3) document.getElementById('erro-nome').classList.add('hidden')" />
              <p id="erro-nome" class="text-error-500 text-sm hidden mt-1">Campo obrigatório.</p>
            </FormField>
            <FormField label="WhatsApp" id="whatsapp">
              <Input id="whatsapp" name="whatsapp" type="tel" placeholder="(11) 99999-9999" oninput="formatarTelefone(this); if(/^\d{11}$/.test(this.value.replace(/\D/g,''))) document.getElementById('erro-whatsapp').classList.add('hidden')" />
              <p id="erro-whatsapp" class="text-error-500 text-sm hidden mt-1">Formato inválido. Use DDD + celular (11 dígitos).</p>
            </FormField>
            <FormField label="Email" id="email">
              <Input id="email" name="email" type="email" placeholder="seu@email.com.br" oninput="if(this.value.trim()){ if(/^[^\s@]+@[^\s@]+\.[a-zA-Z]{2,}(\.[a-zA-Z]{2,})?$/.test(this.value.trim())) document.getElementById('erro-email').classList.add('hidden'); else document.getElementById('erro-email').classList.remove('hidden'); } else { document.getElementById('erro-email').classList.remove('hidden'); }" />
              <p id="erro-email" class="text-error-500 text-sm hidden mt-1">Informe um email válido.</p>
            </FormField>
            <FormField label="Mensagem" id="mensagem">
              <Textarea id="mensagem" name="mensagem" placeholder="Conte sobre sua fachada" rows={4} oninput="if(this.value.trim().length>=10) document.getElementById('erro-mensagem').classList.add('hidden')" />
              <p id="erro-mensagem" class="text-error-500 text-sm hidden mt-1">Campo obrigatório.</p>
            </FormField>
            <div id="form-feedback" class="hidden text-green-600 text-sm font-medium mb-2">Mensagem enviada com sucesso!</div>
            <div class="flex items-center gap-4">
              <Button id="submit-btn" type="submit" variant="primary" size="md" class="w-full md:w-1/2 font-body flex items-center"><LucideMail id="submit-icon" class="inline w-4 h-4 mr-2" />Enviar mensagem</Button>
            </div>
          </form>
        </Card>
      </div>
    </Container>
  </section>

  <Footer
    companyInfo={footerCompany}
    copyright="© 2026 Camargo Gallo Engenharia. Todos os direitos reservados."
    size="lg"
    padding="md"
  />

  <LegalDrawer client:load />

  <script is:inline>
    document.addEventListener('click', function (event) {
      var anchor = event.target.closest('a[href="#privacy"], a[href="#terms"]');
      if (!anchor) return;
      event.preventDefault();
      var target = anchor.getAttribute('href');
      if (target === '#privacy' || target === '#terms') {
        if (location.hash === target) {
          history.replaceState(null, '', location.pathname + location.search);
        } else {
          location.hash = target;
        }
      }
    });
  </script>

  <script is:inline>
    function animarScroll() {
      const el = document.getElementById('titulo-orcamento');
      if (!el) return;
      const target = el.getBoundingClientRect().top + window.scrollY - 20;
      gsap.to({ y: window.scrollY }, {
        y: target,
        duration: 4,
        ease: "power5.out",
        onUpdate: function () {
          window.scrollTo(0, this.targets()[0].y);
        }
      });
    }
    function formatarTelefone(inp) {
      let v = inp.value.replace(/\D/g, '').slice(0, 11);
      if (v.length > 7) v = v.replace(/(\d{2})(\d{5})(\d{4})/, '($1) $2-$3');
      else if (v.length > 2) v = v.replace(/(\d{2})(\d+)/, '($1) $2');
      inp.value = v;
    }
    function formatarEmail(inp) {
      inp.value = inp.value.replace(/[^a-zA-Z0-9.@]/g, '');
    }
    function submeterForm(e) {
      e.preventDefault();
      document.getElementById('erro-nome').classList.add('hidden');
      document.getElementById('erro-whatsapp').classList.add('hidden');
      document.getElementById('erro-email').classList.add('hidden');
      document.getElementById('erro-mensagem').classList.add('hidden');
      const wh = document.getElementById('whatsapp').value.replace(/\D/g, '');
      const em = document.getElementById('email').value.trim();
      let ok = true;
      if (wh.length !== 11) { document.getElementById('erro-whatsapp').classList.remove('hidden'); ok = false; }
      if (!/^[^\s@]+@[^\s@]+\.[a-zA-Z]{2,}(\.[a-zA-Z]{2,})?$/.test(em)) { document.getElementById('erro-email').classList.remove('hidden'); ok = false; }
      const nome = document.getElementById('nome').value.trim();
      if (nome.length === 0 || nome.length < 3) { document.getElementById('erro-nome').classList.remove('hidden'); ok = false; }
      const msg = document.getElementById('mensagem').value.trim();
      if (msg.length === 0 || msg.length < 10) { document.getElementById('erro-mensagem').classList.remove('hidden'); ok = false; }
      if (!ok) return;
      const btn = document.getElementById('submit-btn');
      btn.disabled = true;
      btn.innerHTML = '<span class="inline w-4 h-4 mr-2"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></span>Enviando <span class="dots">● ● ●</span>';
      document.getElementById('form-feedback').classList.add('hidden');
      document.getElementById('form-feedback').classList.remove('text-error-500');
      document.getElementById('form-feedback').classList.remove('text-green-600');
      const form = document.getElementById('contato-form');
      const formData = new FormData(form);
      fetch('/lp-camargo-gallo/send-email.php', { method: 'POST', body: formData })
        .then(r => r.text())
        .then(text => {
          if (text.trim() === 'OK') {
            gtag('event', 'lp_form_submit', { 'event_category': 'contato', 'event_label': 'form_lp' });
            document.getElementById('form-feedback').classList.remove('hidden');
            form.reset();
            document.getElementById('erro-nome').classList.add('hidden');
            document.getElementById('erro-whatsapp').classList.add('hidden');
            document.getElementById('erro-email').classList.add('hidden');
            document.getElementById('erro-mensagem').classList.add('hidden');
            const btn = document.getElementById('submit-btn');
            btn.disabled = false;
            btn.innerHTML = '<span class="inline w-4 h-4 mr-2"><svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></span>Enviar mensagem';
          }
        })
        .catch(() => {
          // erro silencioso; validações individuais já mostram problemas nos inputs
        });
    }
    function validarFormulario(e) {
      document.getElementById('erro-nome').classList.add('hidden');
      document.getElementById('erro-whatsapp').classList.add('hidden');
      document.getElementById('erro-email').classList.add('hidden');
      document.getElementById('erro-mensagem').classList.add('hidden');
      const wh = document.getElementById('whatsapp').value.replace(/\D/g, '');
      const em = document.getElementById('email').value.trim();
      let ok = true;
      if (wh.length !== 11) { document.getElementById('erro-whatsapp').classList.remove('hidden'); ok = false; }
      const nome = document.getElementById('nome').value.trim();
      if (nome.length === 0 || nome.length < 3) { document.getElementById('erro-nome').classList.remove('hidden'); ok = false; }
      const msg = document.getElementById('mensagem').value.trim();
      if (msg.length === 0 || msg.length < 10) { document.getElementById('erro-mensagem').classList.remove('hidden'); ok = false; }
      if (!ok) { e.preventDefault(); }
    }
  </script>

  <script is:inline>
    document.addEventListener('click', function (event) {
      var link = event.target && event.target.closest ? event.target.closest('footer a.footer-contacts-link') : null;
      if (!link) return;
      var href = link.getAttribute('href') || '';
      if (href.indexOf('tel:') === 0) {
        gtag('event', 'lp_phone_click', { 'event_category': 'contato', 'event_label': 'telefone_footer' });
      } else if (href.indexOf('https://wa.me/') === 0) {
        gtag('event', 'lp_whatsapp_click', { 'event_category': 'contato', 'event_label': 'whatsapp_footer' });
      }
    });
  </script>

  <BackToTop client:load>
    <IconSet size="24"><ChevronUp /></IconSet>
  </BackToTop>

  <WhatsappButton client:load />
</BaseLayout>
