---
import BaseLayout from '../layouts/BaseLayout.astro'
import {
  Button,
  Tag,
  Container,
  FormField,
  Input,
  Textarea,
  Heading,
  Text,
  Section,
  Grid,
  Reveal,
  Card,
  FeatureCard,
} from 'ds-grupo-rkb'

const servicos = [
  { titulo: 'Ensaio de Percussão', texto: 'Diagnóstico não destrutivo da aderência de revestimentos.' },
  { titulo: 'Remoção de Revestimentos Soltos', texto: 'Eliminação segura de camadas descoladas da superfície.' },
  { titulo: 'Remoção de Substrato Corroído', texto: 'Tratamento do concreto afetado por carbonatação.' },
  { titulo: 'Remoção de Suportes de Para-raios', texto: 'Desmontagem controlada de fixações comprometidas.' },
  { titulo: 'Hidrojateamento de Fachadas', texto: 'Limpeza profunda com jato de água de alta pressão.' },
  { titulo: 'Limpeza e Tratamento de Armaduras', texto: 'Passivação de aço exposto com produtos inertes.' },
  { titulo: 'Proteção e Recomposição de Concreto', texto: 'Reparo estrutural com argamassa de alta performance.' },
  { titulo: 'Recomposição de Chapisco e Argamassa', texto: 'Restabelecimento da geometria original do substrato.' },
  { titulo: 'Tratamento de Fissuras e Trincas', texto: 'Injeção de resina para selagem e vedação.' },
  { titulo: 'Reparos em Massa Acrílica', texto: 'Correção de superfícies com massa lisa e durável.' },
  { titulo: 'Aplicação de Impermeabilizante Acrílico', texto: 'Barreira protetora contra infiltração de água.' },
  { titulo: 'Pintura com Tinta Super Premium', texto: 'Acabamento de alto desempenho e longa durabilidade.' },
  { titulo: 'Tratamento de Muros e Estruturas Metálicas', texto: 'Proteção anticorrosiva em elementos de aço.' },
  { titulo: 'Acompanhamento Online e Segurança NR-35', texto: 'Monitoramento remoto com conformidade trabalhista.' },
]

---

<BaseLayout title="Camargo Gallo Engenharia — Recuperação de Fachadas" description="Diagnóstico, reparo estrutural e pintura premium com acompanhamento NR-35.">

  <Section tone="surface-alt" size="lg">
    <Container>
      <Reveal client:visible class="w-full block">
        <div class="flex flex-col gap-4 w-full items-center text-center">
          <Tag>Engenharia de Fachadas</Tag>
          <Heading as="1" size="display">Fachadas recuperadas com segurança e garantia</Heading>
          <Text size="lg" tone="secondary">Do ensaio de percussão à pintura super premium — 14 etapas com acompanhamento online e conformidade NR-35.</Text>
          <div class="flex gap-3 pt-2 justify-center">
            <Button as="a" href="#contato">Entrar em contato</Button>
            <Button as="a" href="#contato" variant="secondary">Escrever mensagem</Button>
          </div>
        </div>
      </Reveal>
    </Container>
  </Section>

  <div id="scroll-wrapper">
    <div id="sticky-viewport">
      <div id="central-stage">
        <img id="sequence-img" src="/assets/frames/002.png" alt="Animação de recuperação de fachada" />
      </div>
      <div id="orbit-container" class="hidden md:block">
        <div class="orbit-white-box" aria-label="Destaque"></div>
        {servicos.map((s) => (
          <div class="orbit-card">
            <h2 class="orbit-card-title">{s.titulo}</h2>
            <div role="separator" aria-hidden="true" class="h-2 w-3/4 rounded-full bg-primary-500 my-4"></div>
            <div class="orbit-card-desc">{s.texto}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="md:hidden">
  <Section tone="surface" size="lg" id="servicos">
    <Container>
      <Reveal client:visible>
        <div class="mb-8 flex flex-col gap-3">
          <Tag>14 etapas</Tag>
          <Heading as="2" size="3xl">Serviços completos de ponta a ponta</Heading>
          <Text tone="secondary">Mesmo conteúdo da animação, agora em grade acessível com componentes DS (Card + Grid + tokens semânticos).</Text>
        </div>
      </Reveal>
      <Grid cols={3} gap="md">
        {servicos.map((s) => (
          <Reveal client:visible>
            <FeatureCard divider="3/4" tone="surface-alt">
              <Heading as="2" size="3xl" slot="title">{s.titulo}</Heading>
              <Text size="sm" tone="secondary" slot="description">{s.texto}</Text>
            </FeatureCard>
          </Reveal>
        ))}
      </Grid>
    </Container>
  </Section>
  </div>

  <Section tone="surface-alt" size="lg" id="contato">
    <Container>
      <Grid cols={2} gap="lg">
        <div class="flex flex-col gap-4">
          <Heading as="2" size="2xl">Solicite seu orçamento</Heading>
          <Text tone="secondary">Retorno em até 24h. Atendemos condomínios, indústrias e edifícios comerciais.</Text>
        </div>
        <Card>
          <form class="flex flex-col gap-4" onsubmit="event.preventDefault(); alert('Lead enviado — integrar backend');">
            <FormField label="Nome" id="nome">
              <Input id="nome" placeholder="Seu nome" required />
            </FormField>
            <FormField label="WhatsApp" id="whatsapp">
              <Input id="whatsapp" type="tel" placeholder="(11) 99999-9999" required />
            </FormField>
            <FormField label="Mensagem" id="mensagem">
              <Textarea id="mensagem" placeholder="Conte sobre sua fachada" rows={4} />
            </FormField>
            <Button type="submit" fullWidth>Enviar mensagem</Button>
          </form>
        </Card>
      </Grid>
    </Container>
  </Section>

  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
  <script is:inline>
    gsap.registerPlugin(ScrollTrigger);
    const img = document.getElementById('sequence-img');
    const minFrame = 2;
    const maxFrame = 50;
    let currentFrame = 2;
    const proxy = { progress: 0 };
    function frameSrc(n) {
      return '/assets/frames/' + String(n).padStart(3, '0') + '.png';
    }
    for (let i = minFrame; i <= maxFrame; i++) {
      const preload = new Image();
      preload.src = frameSrc(i);
    }
    const cards = document.querySelectorAll('.orbit-card');
    const totalCards = cards.length;
    const queueStart = 8;
    const queueStagger = 0.08;
    const freezePoint = (totalCards - queueStart) * queueStagger;
    const phases = [
      { from: { x: 90, y: 85 }, to: { x: 10, y: 85 } },
      { from: { x: 10, y: 85 }, to: { x: 10, y: 18 } },
      { from: { x: 10, y: 18 }, to: { x: 90, y: 18 } },
      { from: { x: 90, y: 18 }, to: { x: 90, y: 85 } },
      { from: { x: 90, y: 85 }, to: { x: 90, y: 110 } },
    ];
    const totalPhases = phases.length;
    function interpolatePath(p) {
      if (p < 0) return null;
      if (p >= 1) return { x: 90, y: 110 + (p - 1) * 100 };
      const segmentFloat = p * totalPhases;
      const segmentIndex = Math.min(Math.floor(segmentFloat), totalPhases - 1);
      const t = Math.min(segmentFloat - segmentIndex, 1);
      const from = phases[segmentIndex].from;
      const to = phases[segmentIndex].to;
      return { x: from.x + (to.x - from.x) * t, y: from.y + (to.y - from.y) * t };
    }
    function isOnScreen(x, y) { return x >= -5 && x <= 105 && y >= -5 && y <= 105; }
    function getCardZIndex(x) { return x > 95 ? 1 : 20; }
    function initCards() {
      for (let i = 0; i < totalCards; i++) {
        const card = cards[i];
        if (i < queueStart) {
          const offset = (i / queueStart) * 0.8;
          const pos = interpolatePath(offset);
          if (pos && isOnScreen(pos.x, pos.y)) {
            gsap.set(card, { xPercent: -50, yPercent: -50, left: pos.x + '%', top: pos.y + '%', zIndex: getCardZIndex(pos.x), display: 'block' });
          } else { gsap.set(card, { display: 'none' }); }
        } else {
          gsap.set(card, { xPercent: -50, yPercent: -50, left: '115%', top: '85%', zIndex: 1, display: 'none' });
        }
      }
    }
    initCards();
    ScrollTrigger.create({
      trigger: '#scroll-wrapper',
      start: 'top top',
      end: 'bottom bottom',
      scrub: 1,
      onUpdate: (self) => {
        const globalProgress = self.progress;
        const orbitProgress = globalProgress * freezePoint;
        gsap.to(proxy, {
          progress: globalProgress, duration: 0.3, ease: 'power2.out', overwrite: true,
          onUpdate: () => {
            const frame = Math.round(proxy.progress * (maxFrame - minFrame)) + minFrame;
            if (frame !== currentFrame) { currentFrame = frame; img.src = frameSrc(frame); }
          }
        });
        for (let i = 0; i < totalCards; i++) {
          const card = cards[i];
          if (i < queueStart) {
            const offset = (i / queueStart) * 0.8;
            const cardP = offset + orbitProgress;
            const pos = interpolatePath(cardP);
            const fadeStart = freezePoint - 0.05;
            const isFadingCard5 = i === 3;
            let opacity = 1;
            if (isFadingCard5 && orbitProgress >= fadeStart) opacity = Math.max(0, 1 - (orbitProgress - fadeStart) / 0.05);
            if (pos && isOnScreen(pos.x, pos.y) && pos.y <= 87) {
              card.style.display = 'block';
              gsap.set(card, { xPercent: -50, yPercent: -50, left: pos.x + '%', top: pos.y + '%', zIndex: getCardZIndex(pos.x), opacity: opacity });
            } else { card.style.display = 'none'; card.style.opacity = 1; }
          } else {
            const queueIndex = i - queueStart;
            const entryThreshold = (queueIndex + 1) * queueStagger;
            if (orbitProgress < entryThreshold) { card.style.display = 'none'; }
            else {
              const elapsed = orbitProgress - entryThreshold;
              const pos = interpolatePath(elapsed);
              if (pos && isOnScreen(pos.x, pos.y) && pos.y <= 87) {
                card.style.display = 'block';
                gsap.set(card, { xPercent: -50, yPercent: -50, left: pos.x + '%', top: pos.y + '%', zIndex: getCardZIndex(pos.x) });
              } else { card.style.display = 'none'; }
            }
          }
        }
      }
    });
  </script>
</BaseLayout>
