---
import { getCollection, getEntry } from 'astro:content';
import { insights } from '../../data/insights';
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Container, Heading, Section, Text, Button } from 'ds-grupo-rkb';

export async function getStaticPaths() {
  return insights.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<BaseLayout title={`${post.titulo} | Camargo Gallo Engenharia`} description={post.resumo}>
  <Section tone="warm" class="py-20">
    <Container size="lg">
      <article class="max-w-3xl mx-auto">
        <div class="mb-12 text-center">
          <span class="text-xs uppercase tracking-widest font-bold text-deep px-3 py-1 rounded bg-deep/5 border border-deep/10 inline-block mb-6">
            {post.categoria}
          </span>
          <Heading as="1" size="display" class="mb-4">{post.titulo}</Heading>
          <div class="flex justify-center gap-4 text-sm text-deep/60 font-body">
            <span>Publicado em {new Date(post.data).toLocaleDateString('pt-BR')}</span>
            <span>•</span>
            <span>Leitura de 5 min</span>
          </div>
        </div>

        <div class="mb-12">
          <img 
            src={post.imagem} 
            alt={post.titulo} 
            class="w-full h-auto max-h-[500px] object-cover rounded-2xl shadow-lg"
          />
        </div>

        <div class="prose prose-lg max-w-none text-ink leading-relaxed font-body">
          <p class="text-xl text-deep/80 italic mb-8 border-l-4 border-[var(--color-divider)] pl-6">
            {post.resumo}
          </p>
          <div class="whitespace-pre-wrap text-lg">
            {post.conteudo}
          </div>
        </div>

        <div class="mt-16 pt-8 border-t border-[var(--color-divider)] flex justify-between items-center">
          <Button as="a" href="/insights" variant="secondary" class="font-body">
            ← Voltar aos Insights
          </Button>
        </div>
      </article>
    </Container>
  </Section>
</BaseLayout>
