---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Container, Heading, Section, Button } from 'ds-grupo-rkb';
import { ChevronLeft } from '@lucide/vue';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
---

<BaseLayout title="Portfólio | Camargo Gallo Engenharia" description="Obras e cases de recuperação de fachadas, impermeabilização e engenharia diagnóstica.">

  <SiteHeader surface="brand" />

  <Section tone="brand" class="py-20">
    <Container size="lg">
      <div class="flex flex-col items-center text-center mb-16 gap-4">
        <div role="separator" aria-hidden="true" class="h-4 w-1/2 rounded-full bg-deep"></div>
        <Heading as="1" size="display" class="section-title">Portfólio</Heading>
        <p class="text-deep/70 max-w-2xl font-body">
          Conheça algumas das obras e cases de engenharia diagnóstica, recuperação e impermeabilização realizados pela Camargo Gallo.
        </p>
      </div>

      <div class="mb-8">
        <Button as="a" href="/" variant="ghost" size="md" leadingIcon={ChevronLeft} class="font-body">
          Voltar
        </Button>
      </div>

      <div id="portfolio-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <p id="portfolio-status" class="col-span-full py-12 text-center text-deep/60 font-body">Carregando…</p>
      </div>
    </Container>
  </Section>

  <script is:inline>
    (function () {
      var grid = document.getElementById('portfolio-grid');
      var statusEl = document.getElementById('portfolio-status');

      function esc(value) {
        return String(value == null ? '' : value).replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }

      function meta(item) {
        var parts = [];
        if (item.cidade) parts.push(item.cidade);
        if (item.ano) parts.push(item.ano);
        return parts.join(' · ');
      }

      function cardHTML(item) {
        var href = '/portfolio/' + encodeURIComponent(item.slug || item.id);
        var media = item.imagem
          ? '<img src="' + esc(item.imagem) + '" alt="' + esc(item.titulo) + '" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />'
          : '<div class="flex h-full w-full items-center justify-center bg-deep/5 text-deep/40" aria-hidden="true">' +
            '<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>' +
            '</div>';

        var info = meta(item);

        return '' +
          '<a href="' + href + '" class="group relative flex flex-col w-full h-[400px] rounded-xl shadow-sm transition-all duration-300 ease-out hover:shadow-md hover:-translate-y-1 bg-surface border border-border/50 overflow-hidden">' +
            '<div class="relative h-48 w-full overflow-hidden">' +
              media +
              '<div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex flex-col justify-end p-4">' +
                '<div class="flex justify-between items-end text-white">' +
                  '<span class="text-[10px] uppercase tracking-widest font-bold px-2 py-1 rounded bg-deep/80 backdrop-blur-sm border border-white/20">' + esc(item.categoria || 'Geral') + '</span>' +
                  '<span class="text-xs font-body opacity-90">' + esc(info) + '</span>' +
                '</div>' +
              '</div>' +
            '</div>' +
            '<div class="p-6 flex flex-col flex-1">' +
              '<h3 class="text-xl font-bold text-ink group-hover:text-deep transition-colors duration-300 mb-3 line-clamp-2">' + esc(item.titulo) + '</h3>' +
              '<p class="text-sm text-deep/70 line-clamp-3 mb-6">' + esc(item.descricao) + '</p>' +
              '<div class="mt-auto pt-4 border-t border-border/50 flex items-center justify-between">' +
                '<span class="text-xs font-bold uppercase tracking-wider text-deep">Ver detalhes</span>' +
                '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1 text-deep"><path d="m9 18 6-6-6-6"/></svg>' +
              '</div>' +
            '</div>' +
          '</a>';
      }

      fetch('/api/public/portfolio.php')
        .then(function (response) {
          if (!response.ok) throw new Error('HTTP ' + response.status);
          return response.json();
        })
        .then(function (data) {
          if (!Array.isArray(data)) throw new Error('resposta inesperada da API');

          if (!data.length) {
            statusEl.textContent = 'Nenhuma obra publicada ainda.';
            return;
          }

          grid.innerHTML = data.map(cardHTML).join('');
        })
        .catch(function (error) {
          console.error(error);
          statusEl.textContent = 'Não foi possível carregar o portfólio.';
        });
    })();
  </script>

  <SiteFooter surface="brand" />

</BaseLayout>
