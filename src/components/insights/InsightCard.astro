---
import { Heading, Text, Button } from 'ds-grupo-rkb'
interface Props {
  titulo: string;
  resumo: string;
  data: string;
  categoria: string;
  slug: string;
  imagem: string;
}

const { titulo, resumo, data, categoria, slug, imagem } = Astro.props;
---

<a
  href={`/insights/${slug}`}
  class="group relative flex flex-col w-[300px] h-[400px] rounded-xl shadow-sm transition-all duration-300 ease-out hover:shadow-md hover:-translate-y-1 bg-surface border border-border/50 overflow-hidden"
>
  <!-- Image Section -->
  <div class="relative h-48 w-full overflow-hidden">
    <img 
      src={imagem} 
      alt={titulo} 
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <!-- Overlay for Tag and Date -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex flex-col justify-end p-4">
      <div class="flex justify-between items-end text-white">
        <span class="text-[10px] uppercase tracking-widest font-bold px-2 py-1 rounded bg-deep/80 backdrop-blur-sm border border-white/20">
          {categoria}
        </span>
        <span class="text-xs font-body opacity-90">{data}</span>
      </div>
    </div>
  </div>

  <!-- Content Section -->
  <div class="p-6 flex flex-col flex-1">
    <Heading as="3" size="xl" class="text-ink group-hover:text-deep transition-colors duration-300 mb-3 line-clamp-2">
      {titulo}
    </Heading>
    <Text tone="secondary" class="text-sm line-clamp-3 mb-6">
      {resumo}
    </Text>

    <div class="mt-auto pt-4 border-t border-border/50 flex items-center justify-between">
      <span class="text-xs font-bold uppercase tracking-wider text-deep transition-colors duration-300 group-hover:text-deep-dark">
        Leia mais
      </span>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1 text-deep">
        <path d="m9 18 6-6-6-6"/>
      </svg>
    </div>
  </div>
</a>
