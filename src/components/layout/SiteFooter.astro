---
import { FooterBanner } from 'ds-grupo-rkb'
import LegalDrawer from '../legal/LegalDrawer.vue'
import { footerCompany, surfaceColor, type Surface } from '../../data/site'

interface Props {
  surface?: Surface
}

const { surface = 'surface' } = Astro.props

const color = surfaceColor(surface)
---

<FooterBanner
  class="site-footer"
  data-surface={surface}
  style={`--page-surface: ${color}`}
  bannerImage="/assets/logo-camargo-gallo.png"
  bannerImageAlt="Logo Camargo Gallo"
  bannerTitle="Pronto para começar?"
  bannerDescription="Recuperação e impermeabilização de fachadas com retorno em até 24h."
  bannerCta={{ label: 'Solicite um orçamento', href: '/contato' }}
  companyDescription="Recuperação de fachadas, impermeabilização e engenharia diagnóstica em São Paulo."
  contacts={footerCompany.contacts}
  legalLinks={footerCompany.legalLinks}
  copyright="© 2026 Camargo Gallo Engenharia. Todos os direitos reservados."
  size="lg"
  padding="md"
/>

<LegalDrawer client:load />

<script is:inline>
  document.addEventListener('click', function (event) {
    var anchor = event.target.closest('a[href="#privacy"], a[href="#terms"]');
    if (!anchor) return;
    event.preventDefault();
    var target = anchor.getAttribute('href');
    if (target === '#privacy' || target === '#terms') {
      if (location.hash === target) {
        history.replaceState(null, '', location.pathname + location.search);
      } else {
        location.hash = target;
      }
    }
  });
</script>
