---
import { FooterBanner } from 'ds-grupo-rkb'
import LegalDrawer from '../legal/LegalDrawer.vue'
import { footerCompany, surfaceColor, type Surface } from '../../data/site'
import { siteBase, assetUrl } from '../../lib/paths'

interface Props {
  surface?: Surface
  /** Titulo e descricao do banner sao falados pelo rodape inteiro, entao o
      padrao mora aqui como literal e nao em src/data/site.ts: o `bannerProps`
      de la tem os mesmos dois textos e ninguem importa. Props opcional para
      uma pagina nenhuma trocar so o banner dela — foi o que a /seguranca fez
      com o texto da marca. */
  bannerTitle?: string
  bannerDescription?: string
}

const {
  surface = 'surface',
  bannerTitle = 'Pronto para começar?',
  bannerDescription = 'Recuperação e impermeabilização de fachadas\ncom retorno em até 24h.',
} = Astro.props

const color = surfaceColor(surface)
---

<FooterBanner
  class="site-footer whitespace-pre-line"
  data-surface={surface}
  style={`--page-surface: ${color}`}
  bannerImage={assetUrl('/assets/logo-camargo-gallo.png')}
  bannerImageAlt="Logo Camargo Gallo"
  bannerTitle={bannerTitle}
  bannerDescription={bannerDescription}
  bannerCta={{ label: 'Solicite um orçamento', href: siteBase + '/contato' }}
  companyDescription="Recuperação de fachadas, impermeabilização e engenharia diagnóstica em São Paulo."
  contacts={footerCompany.contacts}
  legalLinks={footerCompany.legalLinks}
  copyright="© 2026 Camargo Gallo Engenharia. Todos os direitos reservados."
  size="lg"
  padding="md"
/>

<LegalDrawer client:load />

<style is:global>
  @media (min-width: 640px) {
    /* O href ganha o prefixo do deploy no staging (/staging/contato). */
    .site-footer a[href$="/contato"] {
      margin-left: auto;
    }
  }
</style>

<script is:inline>
  document.addEventListener('click', function (event) {
    var anchor = event.target.closest('a[href="#privacy"], a[href="#terms"]');
    if (!anchor) return;
    event.preventDefault();
    var target = anchor.getAttribute('href');
    if (target === '#privacy' || target === '#terms') {
      if (location.hash === target) {
        history.replaceState(null, '', location.pathname + location.search);
      } else {
        location.hash = target;
      }
    }
  });
</script>
