---
import { Button, Header, BrandIcon } from 'ds-grupo-rkb'
import { headerNavSite, surfaceColor, whatsappHref, type Surface } from '../../data/site'

interface Props {
  nav?: typeof headerNavSite
  spacer?: boolean
  surface?: Surface
}

const { nav = headerNavSite, spacer = true, surface = 'surface' } = Astro.props

const color = surfaceColor(surface)

/* No topo a barra fica transparente (lp.css), então o spacer leva a cor da
   superfície quando ela não é o branco padrão: sem isso a faixa de 76px nasce
   branca e emenda com a section colorida logo abaixo (insights em warm,
   /portfolio em brand). */
const spacerColor = surface === 'surface' ? undefined : color

/* data-glass marca as páginas com spacer (todas menos a home): nelas a barra
   fica limpa no topo e ganha o vidro do DS quando o header gruda. */
const glass = spacer
---

<script>
  const header = document.querySelector('.site-header[data-glass]')
  if (header) {
    const sync = () => header.toggleAttribute('data-scrolled', window.scrollY > 10)
    sync()
    window.addEventListener('scroll', sync, { passive: true })

    const highlightActiveMenuItem = () => {
      const currentPath = header.getAttribute('data-current-page')
      if (!currentPath) return

      const activeElements = header.querySelectorAll('.active, [aria-current="page"]')
      activeElements.forEach(el => {
        el.classList.remove('active')
        el.removeAttribute('aria-current')
      })

      const getLinks = (element) => {
        const shadowRoot = element.shadowRoot
        if (shadowRoot) {
          return shadowRoot.querySelectorAll('a[href], button[href]')
        }
        return element.querySelectorAll('a[href], button[href]')
      }

      const links = getLinks(header)
      links.forEach(link => {
        const href = link.getAttribute('href')
        if (!href) return

        if (href === currentPath) {
          link.classList.add('active')
          link.setAttribute('aria-current', 'page')
          return
        }

        if ((href + '/') === currentPath || href === (currentPath + '/')) {
          link.classList.add('active')
          link.setAttribute('aria-current', 'page')
          return
        }

        if (href !== '/' && currentPath.startsWith(href)) {
          const pathAfterHref = currentPath.substring(href.length)
          if (pathAfterHref === '' || pathAfterHref.startsWith('/')) {
            link.classList.add('active')
            link.setAttribute('aria-current', 'page')
          }
        }
      })
    }

    setTimeout(highlightActiveMenuItem, 0)

    document.addEventListener('astro:page-load', () => {
      header.setAttribute('data-current-page', window.location.pathname)
      setTimeout(highlightActiveMenuItem, 0)
    })
  }
</script>

<Header
  client:load
  boxed
  size="lg"
  position="fixed"
  nav={nav}
  class="site-header"
  data-surface={surface}
  data-glass={glass ? '' : undefined}
  data-current-page={Astro.url.pathname}
  style={`--page-surface: ${color}`}
>
  <Button
    slot="aside"
    iconOnly
    size="lg"
    as="a"
    href={whatsappHref}
    aria-label="Falar no WhatsApp"
    class="bg-[#25D366]! text-white! hover:bg-[#128C7E]!"
  >
    <BrandIcon name="whatsapp" class="h-5 w-5" />
  </Button>
</Header>

{spacer && <div aria-hidden="true" class="h-[4.75rem]" style={spacerColor ? `background-color: ${spacerColor}` : undefined}></div>}
