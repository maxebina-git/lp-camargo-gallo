---
import { Button, Container, Heading, Section } from 'ds-grupo-rkb'
---

<script>
  // Duas leituras da mesma lista, escolhidas por gsap.matchMedia() para que a
  // troca de layout acompanhe resize e rotacao (o if/else avaliado uma unica vez
  // no load deixava a pagina travada no modo anterior ao virar o celular).
  // Cada contexto cuida do seu trigger e do que escreve no DOM; ao sair do
  // breakpoint o matchMedia reverte tudo — inclusive o transform inline da faixa.
  //
  // - desktop: acordeao vertical. Uma obra expandida por vez, na ordem da lista.
  //   O ScrollTrigger cuida so do pin; o indice sai do progresso, o que torna a
  //   troca bidirecional — rolar para cima refaz o caminho ao contrario.
  // - mobile: faixa horizontal. Todos os itens ficam expandidos ("ativos"), sem
  //   is-acordeao; o scroll vertical da pagina vira o avanco da faixa em X.
  //
  // O window.gsap/ScrollTrigger sao definidos pelo BaseLayout (modulos bundlados),
  // entao init so roda depois do load para nao depender da ordem de execucao.
  let inicializado = false

  function initPortfolio() {
    if (inicializado) return
    const raiz = document.querySelector('[data-portfolio]')
    if (!raiz) return
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return

    const gsap = window.gsap
    const ScrollTrigger = window.ScrollTrigger
    if (!gsap || !ScrollTrigger) return
    gsap.registerPlugin(ScrollTrigger)

    inicializado = true

    const mm = gsap.matchMedia()

    mm.add('(min-width: 48rem)', () => {
      setupDesktopAccordion(raiz, gsap, ScrollTrigger)
    })

    mm.add('(max-width: 47.99rem)', () => {
      setupMobileHorizontal(raiz, gsap, ScrollTrigger)
    })
  }

  // Faixa horizontal movida pelo scroll vertical. A lista NAO e um scroll
  // container: e um track de width:max-content que o GSAP translada em X. Medir
  // o elemento certo importa — o wrapper [data-portfolio] nunca rola na
  // horizontal, entao medir ele dava scrollLeft sempre 0 e end '+0'.
  function setupMobileHorizontal(raiz, gsap, ScrollTrigger) {
    const faixa = raiz.querySelector('[data-portfolio-lista]')
    if (!faixa) return
    const itens = gsap.utils.toArray('[data-portfolio-item]', faixa)
    // Cases + o card final de CTA. E quem define o tamanho da faixa e o numero
    // de degraus do snap; o card nao tem data-portfolio-item, entao o acordeao
    // do desktop nao o enxerga.
    const cartoes = gsap.utils.toArray('[data-portfolio-item], [data-portfolio-cta]', faixa)
    const total = itens.length
    if (total < 2) return

    // O layout do track so vale com JS rodando: sem ele (reduced-motion, script
    // bloqueado) a lista precisa continuar como pilha vertical legivel. E o
    // is-acordeao do desktop e removido aqui porque o revert do matchMedia nao
    // desfaz classe adicionada na mao — sem isso, redimensionar de desktop para
    // mobile deixaria os cards colapsados em 4.5rem dentro da faixa.
    raiz.classList.remove('is-acordeao')
    raiz.classList.add('is-horizontal')

    // Delocamento total da faixa: a distancia entre a borda esquerda da janela
    // visivel e a borda esquerda do ultimo card (o de CTA, quando existe) — e
    // ele que segura o pin: o end so bate quando ele chega na posicao de descanso.
    // Medir por offsetLeft em vez de scrollWidth e offsetWidth: ja desconta o
    // padding-inline da faixa, nao depende de todas as cards terem a mesma
    // largura e nao acumula o arredondamento inteiro de offsetWidth a cada degrau.
    const distancia = () => {
      const ultimo = cartoes[cartoes.length - 1]
      if (!ultimo) return 0
      return Math.max(0, ultimo.offsetLeft - faixa.offsetLeft)
    }

    // Acima de 1 a faixa anda mais devagar que o dedo, o que da tempo de ler a
    // obra antes da proxima entrar. Em 6 cards isso passa de 3 telas de scroll.
    const ritmo = 1.15

    const trilha = gsap.to(faixa, {
      x: () => -distancia(),
      ease: 'none',
      scrollTrigger: {
        trigger: raiz,
        start: 'top top',
        end: () => '+=' + distancia() * ritmo,
        pin: true,
        pinSpacing: true,
        anticipatePin: 1,
        scrub: 0.4,
        invalidateOnRefresh: true,
        // Um passo por card (5 cases + o de CTA), como no desktop. progress e o
        // avanco linear do tween, e como todas as cards tem a mesma largura os
        // offsets sao uniformes: 1/(n-1) cai exatamente no inicio de cada uma.
        snap: {
          snapTo: 1 / (cartoes.length - 1),
          directional: false,
          inertia: false,
          duration: { min: 0.15, max: 0.4 },
          delay: 0.03,
          ease: 'power2.inOut',
        },
      },
    })

    // Recalcular o end depois que o layout assenta. Espera fontes e todas as
    // imagens da faixa (lazy pode atrasar scrollWidth/offsetLeft no celular).
    const reagir = () => ScrollTrigger.refresh()
    if (document.fonts?.ready) document.fonts.ready.then(reagir)

    const fotos = Array.from(faixa.querySelectorAll('img'))
    const pendentes = fotos.filter((img) => !img.complete)
    if (pendentes.length) {
      let restantes = pendentes.length
      const umaVez = () => {
        if (--restantes <= 0) reagir()
      }
      pendentes.forEach((img) => {
        img.addEventListener('load', umaVez, { once: true })
        img.addEventListener('error', umaVez, { once: true })
      })
    } else if (fotos.length) {
      reagir()
    }

    // matchMedia revert chama a funcao de cleanup devolvida aqui.
    let ro = null
    if (window.ResizeObserver) {
      let w = faixa.offsetWidth
      let h = document.documentElement.clientHeight
      ro = new ResizeObserver(() => {
        const nw = faixa.offsetWidth
        const nh = document.documentElement.clientHeight
        if (nw === w && nh === h) return
        w = nw
        h = nh
        reagir()
      })
      ro.observe(faixa)
      ro.observe(document.documentElement)
    }

    // Parallax da foto, preso ao movimento do track. O alvo e o <img> dentro do
    // thumb, nunca o thumb: o container tem overflow:hidden e translada-lo
    // mostraria o fundo da caixa nas pontas.
    itens.forEach((item) => {
      const img = item.querySelector('[data-portfolio-thumb] img')
      if (!img) return
      gsap.fromTo(
        img,
        { xPercent: 4 },
        {
          xPercent: -4,
          ease: 'none',
          scrollTrigger: {
            trigger: item,
            containerAnimation: trilha,
            start: 'left right',
            end: 'right left',
            scrub: true,
            invalidateOnRefresh: true,
          },
        }
      )
    })

    return () => {
      if (ro) ro.disconnect()
    }
  }

  function setupDesktopAccordion(raiz, gsap, ScrollTrigger) {
    const itens = Array.from(raiz.querySelectorAll('[data-portfolio-item]'))
    const total = itens.length
    if (total < 2) return

    const passos = total - 1
    let indice = 0

    // Simetria com o mobile: as duas classes sao mutuamente exclusivas e cada
    // setup limpa a marca da outra, porque o revert do matchMedia so desfaz o
    // que o GSAP criou, nao o que a mao adicionou.
    raiz.classList.remove('is-horizontal')
    raiz.classList.add('is-acordeao')

    function aplicar() {
      itens.forEach((item, i) => {
        item.classList.toggle('is-ativo', i === indice)
        item.classList.toggle('is-recolhida', i !== indice)
      })
    }

    const btnCases = document.getElementById('portfolio-cases-btn')
    const mostrarBtn = () => btnCases?.classList.add('is-visible')
    const ocultarBtn = () => btnCases?.classList.remove('is-visible')

    ScrollTrigger.create({
      trigger: raiz,
      start: 'top top',
      end: () => '+=' + window.innerHeight * passos,
      pin: true,
      pinSpacing: true,
      anticipatePin: 1,
      onEnter: mostrarBtn,
      onLeave: ocultarBtn,
      onEnterBack: mostrarBtn,
      onLeaveBack: ocultarBtn,
      onUpdate: (self) => {
        const alvo = Math.min(total - 1, Math.max(0, Math.round(self.progress * passos)))
        if (alvo !== indice) {
          indice = alvo
          aplicar()
        }
      },
      onRefresh: aplicar,
    })

    aplicar()
  }

  function esc(valor) {
    return String(valor == null ? '' : valor).replace(/[&<>"']/g, (c) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;',
    }[c]))
  }

  function itemHTML(obra) {
    const href = '/portfolio/' + encodeURIComponent(obra.slug || obra.id)
    const foto = obra.imagem
      ? '<img src="' + esc(obra.imagem) + '" alt="' + esc(obra.titulo) + '" width="600" height="600" class="h-full w-full object-cover" loading="lazy" decoding="async" />'
      : ''

    return '' +
      '<li data-portfolio-item class="grid items-center gap-6 md:grid-cols-[1fr_2fr_1fr] md:gap-8 md:overflow-hidden">' +
        '<div class="flex items-center gap-4 md:min-h-0 md:flex-col md:items-end md:justify-center md:gap-3 text-right" data-portfolio-titulo>' +
          '<h3 class="font-display text-xl leading-snug font-semibold text-ink">' + esc(obra.titulo) + '</h3>' +
          '<span role="separator" aria-hidden="true" class="h-px flex-1 bg-border md:w-full"></span>' +
        '</div>' +
        '<div class="flex justify-center" data-portfolio-foto>' +
          '<div data-portfolio-thumb class="aspect-[3/2] w-full overflow-hidden rounded-xl bg-surface-alt md:max-w-none">' +
            foto +
          '</div>' +
        '</div>' +
        '<div class="flex flex-col gap-3" data-portfolio-texto>' +
          '<p class="font-body text-base leading-normal font-normal text-text-secondary">' + esc(obra.descricao) + '</p>' +
          '<a href="' + href + '" class="cta-portfolio self-start mt-2 inline-flex items-center justify-center gap-2 select-none rounded-md font-medium transition duration-500 ease-out cursor-pointer hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.99] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 bg-primary-500 text-on-primary hover:bg-primary-700 active:bg-primary-700 h-8 px-3 text-sm">Ver detalhes <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></a>' +
        '</div>' +
      '</li>'
  }

  // Card final da faixa mobile: nao e um case, e a saida para /portfolio, com o
  // mesmo botao primario do botao flutuante do desktop. Precisa ter a mesma
  // largura dos cases (84vw, ver .is-horizontal) para os offsets ficarem
  // uniformes e o snap de 1/(n-1) cair em cada card.
  function ctaHTML() {
    const chevron = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>'
    return '' +
      '<li data-portfolio-cta class="items-center justify-center">' +
        '<a href="/portfolio" aria-label="Veja mais cases" class="inline-flex h-10 select-none items-center justify-center gap-2 rounded-md bg-primary-500 px-5 text-sm font-medium text-on-primary transition duration-500 ease-out cursor-pointer hover:-translate-y-0.5 hover:bg-primary-700 active:translate-y-0 active:scale-[0.99] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">Veja + cases ' + chevron + '</a>' +
      '</li>'
  }

  const lista = document.querySelector('[data-portfolio-lista]')
  const status = document.getElementById('portfolio-home-status')

  fetch('/api/public/portfolio.php')
    .then((response) => {
      if (!response.ok) throw new Error('HTTP ' + response.status)
      return response.json()
    })
    .then((data) => {
      if (!Array.isArray(data)) throw new Error('Resposta inesperada da API')
      const obras = data.slice(0, 5)
      if (!obras.length) {
        if (status) status.textContent = 'Nenhuma obra publicada ainda.'
        return
      }
      if (lista) lista.innerHTML = obras.map(itemHTML).join('') + ctaHTML()
      if (status) status.remove()
      if (document.readyState === 'complete') initPortfolio()
      else window.addEventListener('load', initPortfolio, { once: true })
    })
    .catch((error) => {
      console.error(error)
      if (status) status.textContent = 'Não foi possível carregar o portfólio.'
    })
</script>

<Section tone="brand" id="portfolio" class="py-16 md:py-0">
  <div data-portfolio class="h-[100dvh] overflow-hidden">
    <Container size="lg" class="flex h-full flex-col py-10 md:justify-center md:py-16">
      <div class="mb-6 flex flex-col items-center gap-4 text-center md:mb-6">
        <div role="separator" aria-hidden="true" class="h-4 w-[75%] rounded-full bg-deep"></div>
        <Heading as="2" size="display" class="section-title">Portfólio</Heading>
        <Heading as="3" size="xl" class="text-deep" data-portfolio-subtitulo>
          Projetos selecionados de recuperação, modernização e manutenção de fachadas.
        </Heading>
      </div>

      <ul data-portfolio-lista class="flex-1 md:justify-center">
        <li id="portfolio-home-status" class="py-12 text-center font-body text-deep/70">Carregando…</li>
      </ul>
    </Container>
  </div>
  </Section>

  <!-- Botao flutuante de portfolio: aparece apenas durante o pin -->
  <Button
    as="a"
    href="/portfolio"
    variant="primary"
    size="md"
    id="portfolio-cases-btn"
    aria-label="Veja mais cases"
    class="portfolio-cases-btn fixed bottom-8 z-[60] show-on-desktop-only inline-flex items-center justify-center gap-2"
  >
    Veja + cases
  </Button>

<style is:global>
  /* O estado de acordeao so vale a partir de md E quando o JS rodou. Sem isso —
     mobile, reduced-motion ou JS bloqueado — todos os itens ficam expandidos em
     fluxo normal, legiveis. */

  /* O item contrai pela altura; a transicao fica no proprio elemento para o
     mobile nunca animar nada. */
  [data-portfolio-item] {
    transition: height 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Sem max-height aqui: ele mudaria junto com o estado, so que sem transicao,
     e prenderia a altura animada num valor novo — o item fecharia num salto.
     A altura vive no md (height 4.5rem/20rem); abaixo disso o item fica com a
     altura natural, que e o fallback legivel. */
  [data-portfolio].is-acordeao [data-portfolio-item] {
    grid-template-rows: minmax(0, 1fr);
    overflow: hidden;
  }

  [data-portfolio-item] [data-portfolio-titulo],
  [data-portfolio-item] [data-portfolio-titulo] h3,
  [data-portfolio-item] [data-portfolio-foto],
  [data-portfolio-item] [data-portfolio-texto],
  [data-portfolio-item] [data-portfolio-thumb],
  [data-portfolio-item] [data-portfolio-foto] img {
    transition:
      opacity 400ms ease-out,
      filter 400ms ease-out;
  }

  /* A altura da descricao fecha junto com o item, nao de um golpe. */
  [data-portfolio-item] [data-portfolio-texto] {
    transition:
      opacity 400ms ease-out,
      filter 400ms ease-out,
      max-height 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* O thumb muda de altura pelo max-height: height:auto (aspect-ratio) nao
     interpola, entao fechar de auto para um valor fixo dava um salto. */
  [data-portfolio-item] [data-portfolio-thumb] {
    transition:
      width 600ms cubic-bezier(0.22, 1, 0.36, 1),
      max-width 600ms cubic-bezier(0.22, 1, 0.36, 1),
      max-height 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* 16px entre os cards em toda a pilha vertical (fallback mobile e acordeao
     desktop). Nao e row-gap: a lista e contenedor de bloco e row-gap so vale em
     flex/grid — o antigo row-gap de 0.5rem era morto, e era por isso que os
     cards ficavam colados. A margem no irmao seguinte resolve sem trocar o
     display da lista: com flex, o md:justify-center do markup passaria a valer
     e, em tela baixa, a pilha (1 expandida + 4 recolhidas) transbordaria para
     cima por cima do cabecalho. Na faixa horizontal ela e zerada abaixo: o gap
     do track ja resolve e, em row-direction, margem toparia e desalinharia os
     cards entre si. */
  [data-portfolio-lista] > [data-portfolio-item] + [data-portfolio-item] {
    margin-top: 1rem;
  }

  @media (min-width: 48rem) {
    [data-portfolio].is-acordeao [data-portfolio-item] {
      /* 4rem (era 4.5rem): a coluna tem 100dvh e o justify-center corta os dois
         lados pelo excedente/2, entao cada px de pilha vale meio px de corte em
         tela baixa. Os -32px daqui somados aos -32px do card ativo anulam os
         +64px do gap de 16px e devolvem o corte original (41px em 1366x768). */
      height: 4rem;
      /* A linha precisa ter a altura do item: sem isso o grid usa a altura do
         conteudo (titulo e descricao continuam ocupando espaco mesmo com
         opacity 0) e o align-items:center empurra a foto para fora da caixa,
         ja que o overflow do item corta. */
      grid-template-rows: minmax(0, 1fr);
    }

    [data-portfolio].is-acordeao [data-portfolio-item].is-ativo {
      /* 18rem (era 20rem) - ver comentario da altura da linha acima. */
      height: 18rem;
    }

    /* min() impede a foto de estourar a coluna em telas estreitas de desktop;
       o aspect-square do elemento resolve a altura a partir da largura. */
    [data-portfolio].is-acordeao [data-portfolio-thumb] {
      width: 100%;
      max-width: 100%;
    }

    /* Fechado: a foto mantem a largura da ativa e so perde a altura, virando
       uma faixa com os quatro cantos arredondados visiveis. Titulo e descricao
       voltam a aparecer, so que recuados e desfocados.
       max-height e nao height: com max-height alto demais a caixa continua na
       altura natural do aspect-ratio (o visual do ativo nao muda) e o valor
       interpola com o do recolhido, enquanto a altura visivel e a que o item
       anima. */
    [data-portfolio].is-acordeao [data-portfolio-item].is-ativo [data-portfolio-thumb] {
      max-height: 1000px;
    }

    [data-portfolio].is-acordeao [data-portfolio-item].is-recolhida [data-portfolio-thumb] {
      max-height: 4rem;
    }

    /* Mesma transparencia nos tres blocos do item fechado, com o titulo mais
       legivel por ser o que identifica a obra. */
    [data-portfolio].is-acordeao [data-portfolio-item].is-recolhida [data-portfolio-foto],
    [data-portfolio].is-acordeao [data-portfolio-item].is-recolhida [data-portfolio-texto] {
      opacity: 0.5;
    }

    [data-portfolio].is-acordeao [data-portfolio-item].is-recolhida [data-portfolio-titulo] {
      opacity: 0.25;
    }

    [data-portfolio].is-acordeao [data-portfolio-item].is-recolhida [data-portfolio-titulo] h3 {
      filter: blur(6px);
    }

    [data-portfolio].is-acordeao [data-portfolio-item].is-recolhida [data-portfolio-foto] img {
      filter: blur(3px);
    }

    /* A descricao e o bloco mais alto dos tres; fechar em 50% da altura evita
        que a faixa de texto saia cortada no meio de uma linha. */
    [data-portfolio].is-acordeao [data-portfolio-item].is-recolhida [data-portfolio-texto] {
      filter: blur(4px);
      max-height: 50%;
      overflow: hidden;
    }

    /* none nao interpola: sem um valor no estado ativo o max-height pulava de
       50% para o inicial a cada troca. 100% da linha (20rem) nao prende a
       descricao natural e esta no mesmo tipo de unidade do 50%. */
    [data-portfolio].is-acordeao [data-portfolio-item].is-ativo [data-portfolio-texto] {
      max-height: 100%;
    }

    /* CTA: aparece apenas quando o item esta ativo, com fade. */
    .cta-portfolio {
      opacity: 0;
      pointer-events: none;
    }

    [data-portfolio-item].is-ativo .cta-portfolio {
      opacity: 1;
      pointer-events: auto;
    }
  }

  /* Botao flutuante de portfolio: vem da dir (proximo do WhatsApp) para esq
     (posicao final), da transparencia 0 para 100, apenas durante o pin. */
  .portfolio-cases-btn {
    opacity: 0;
    right: 4rem;
    transition: right 600ms ease-out, opacity 400ms ease-out;
  }

  .portfolio-cases-btn.is-visible {
    opacity: 1;
    right: 10rem;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-portfolio-item] {
      transition: none;
    }

    .portfolio-cases-btn,
    .portfolio-cases-btn.is-visible {
      transition: none;
      opacity: 1;
      right: 13rem;
    }
  }

  /* Mobile: faixa horizontal. A lista deixa de ser um scroll container (nao tem
     mais overflow-x nem scroll-snap) e vira um track de width:max-content que o
     GSAP translada em X. O clip fica no [data-portfolio], que tem overflow:hidden
     em todos os breakpoints e por isso recorta o transbordo do track.

     Tudo e prefixado com .is-horizontal, que so o setupMobileHorizontal adiciona:
     sem GSAP nao existe quem mova o track, e um width:max-content parado
     mostraria apenas o primeiro card. Fora desse estado (reduced-motion, JS
     bloqueado, erro na API) a lista volta a ser a pilha vertical legivel. */
  @media (max-width: 47.99rem) {
    [data-portfolio].is-horizontal [data-portfolio-lista] {
      display: flex;
      width: max-content;
      /* O track preenche a altura que sobra da coluna (100dvh menos cabecalho):
         o card nao cresce com o conteudo e o CTA, ancorado embaixo pelo
         margin-top:auto do texto, nunca sai da tela — em telas baixas e a foto
         (flexgrow/encolhe) que cede mediante a altura fixa do bloco. */
      height: 100%;
      /* min-height:0 deixa o ul (flex-1 da coluna) encolher abaixo do minimo
         natural do track; sem isso, o card crescia com o conteudo e o CTA
         passava da borda da tela em aparelhos baixos. */
      min-height: 0;
      align-items: stretch;
      gap: 1rem;
      padding-inline: 1rem;
      will-change: transform;
    }

    /* Os 16px da pilha vertical sao gap do track aqui; a margem top dos irmaos
       seria margem no cross-axis e tiraria metade dos cards de linha. */
    [data-portfolio].is-horizontal
      [data-portfolio-lista]
      > [data-portfolio-item]
      + [data-portfolio-item] {
      margin-top: 0;
    }

    /* 84vw deixa o peek do vizinho aparecer na direita. A foto e quem cresce
       para completar a altura do card (flex:1 abaixo), e assim todos os cards
       ficam com a mesma altura, independente do tamanho da descricao. O
       aspect-ratio do utilitario precisa ser zerado porque ele brigaria com a
       altura flexivel. */
