---
import { Container, Heading, Section, Text } from 'ds-grupo-rkb'
import AboutBadges from './AboutBadges.vue'
import { diferenciais } from '../../data/diferenciais'
---

<Section tone="warm" size="lg" class="py-16 about-static">
  <Container size="lg">
    <div class="grid gap-10 md:grid-cols-2 md:items-center">
      <div class="flex flex-col gap-4">
        <Heading as="2" size="display" class="section-title">Sobre a Camargo Gallo Engenharia</Heading>
        <Heading as="3" size="xl" class="text-deep">Técnica e Trabalho, Renovando Construções</Heading>
        <Text tone="secondary">
          A Camargo Gallo Engenharia é uma empresa especializada na recuperação e tratamento de fachadas
          prediais, com foco nas anomalias e patologias construtivas e possui elevada capacitação técnica
          para a correta intervenção e manutenção do seu empreendimento.
        </Text>
      </div>
      <div class="relative aspect-[1201/718] overflow-hidden rounded-xl">
        <img
          src="/about-image.png"
          alt="Equipe da Camargo Gallo executando recuperação de fachada"
          width="1201"
          height="718"
          class="h-full w-full object-cover"
          decoding="async"
        />
      </div>
    </div>

    <AboutBadges class="mt-10" />

    <AboutBadges class="mt-6 about-badges--extra" items={diferenciais} />
  </Container>
</Section>

<style is:global>
  /* Versao estatica da secao (usada em /empresa): sem parallax, sem desenho
     dos icones por GSAP e sem o float dos cards. O CSS global de lp.css define
     animation-name: badgeFloat em .about-badge; o floatStyle inline do
     AboutBadges.vue so grava duration/delay, nao o nome — entao animation: none
     aqui corta o float so nesta pagina. */
  .about-static .about-badge {
    animation: none;
  }

  /* Segunda fileira de badges (diferenciais): 4 cards, mesma grade.
     O grid-template-columns de .about-badges em lp.css e 5 colunas — com 4
     items sobra um buraco a direita. Forcando 4 colunas fica pareado. */
  .about-static .about-badges--extra .about-badges {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  @media (width < 80rem) {
    .about-static .about-badges--extra .about-badges {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* No mobile o marquee de lp.css pressupoe 5 cards por repetição (10 na
     trilha); com 4 o ciclo andaria errado. Casa a fileira extra em grid
     estatica de 2 colunas. */
  @media (width < 40rem) and (prefers-reduced-motion: no-preference) {
    .about-static .about-badges--extra .about-badges {
      display: grid;
      width: auto;
      animation: none;
    }

    .about-static .about-badges--extra .about-badge {
      width: auto;
      flex: none;
    }

    .about-static .about-badges--extra .about-badge--clone {
      display: none;
    }
  }
</style>
