---
import 'ds-grupo-rkb/style.css'
import '../styles/lp.css'
import '../styles/global.css'

interface Props {
  title: string
  description?: string
}

const { title, description } = Astro.props
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RVC8M3ZG3K"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-RVC8M3ZG3K');
    </script>
    <meta name="description" content={description} />
    <title>{title}</title>
    <meta property="og:title" content="Restauração de Fachadas e Pintura Predial em SP | Camargo Gallo Engenharia" />
    <meta property="og:description" content="Especialistas em reforma de fachadas, impermeabilização e pintura predial em São Paulo. Solicite um orçamento com a Camargo Gallo Engenharia." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://camargogallo.com.br/lp-camargo-gallo/" />
    <meta property="og:image" content="https://camargogallo.com.br/lp-camargo-gallo/og-image.jpg" />
    <link rel="icon" href="/lp-camargo-gallo/favicon.ico" type="image/x-icon" />
    <link rel="sitemap" href="/lp-camargo-gallo/sitemap-index.xml" />
    <script>
      import { gsap } from 'gsap'
      import { ScrollTrigger } from 'gsap/ScrollTrigger'
      gsap.registerPlugin(ScrollTrigger)
      window.gsap = gsap
      window.ScrollTrigger = ScrollTrigger
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "Camargo Gallo Engenharia",
      "image": "https://camargogallo.com.br/lp-camargo-gallo/og-image.jpg",
      "url": "https://camargogallo.com.br",
      "telephone": "+551129248556",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Rua Maria José Rangel, 159, Vila São Paulo",
        "addressLocality": "São Paulo",
        "addressRegion": "SP",
        "postalCode": "04650-180",
        "addressCountry": "BR"
      },
      "description": "Especialistas em restauração de fachadas, pintura predial, impermeabilização e retrofit em São Paulo.",
      "areaServed": "São Paulo",
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Serviços de Engenharia",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Restauração de Fachadas" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Pintura Predial" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Impermeabilização" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Retrofit de Fachadas" } }
        ]
      }
    }
    </script>
  </head>
  <body data-theme="camargo-gallo">
    <slot />
  </body>
</html>
